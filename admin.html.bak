  tiktok: 'M16 2h3a7 7 0 006 6v3a10 10 0 01-6-2v8a7 7 0 11-7-7c.4 0 .7 0 1 .1v3.2a4 4 0 105 3.7V2z',
  x: 'M4 4l7 9-7 7h3l6-6 5 6h5l-8-9 7-7h-3l-5 5-4-5z',
  threads: 'M12 2a10 10 0 100 20 10 10 0 000-20zm5 11.5c-.4 2.3-2 3.6-4.4 3.7-2.6.1-4.3-1.4-4.4-3.9 0-1 .2-1.8.7-2.4.6-.8 1.6-1.2 2.9-1.2 1.2 0 2.1.4 2.6 1.1.4.6.5 1.3.4 2.1-.1.9-.6 1.4-1.3 1.4-.6 0-1-.3-1-.8 0-.5.3-.7.7-.8.2 0 .3-.1.3-.3 0-.4-.4-.7-1.1-.7-.8 0-1.4.5-1.5 1.4-.1 1 .5 1.7 1.6 1.7 1.2 0 2-.7 2.2-2 .2-1.3-.3-2.4-1.4-3-.7-.4-1.6-.5-2.6-.4-2.5.2-4 2-3.9 4.7.1 2.6 1.9 4.2 4.5 4 2.2-.1 3.7-1.3 4-3.3z',
  facebook: 'M22 12a10 10 0 10-11.6 9.9v-7H7.8V12h2.6V9.8c0-2.6 1.5-4 3.9-4 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0022 12z',
  pinterest: 'M12 2a10 10 0 00-3.7 19.3c-.1-.8-.2-2 0-2.9l1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.6-.2 1 .5 1.9 1.6 1.9 1.9 0 3.3-2.5 3.3-5.4 0-2.3-1.5-3.9-3.8-3.9-2.6 0-4.2 1.9-4.2 4 0 .8.3 1.6.7 2.1.1.1.1.2.1.3l-.3 1.1c0 .2-.2.3-.4.2-1.2-.6-2-2.3-2-3.8 0-3.1 2.3-5.9 6.4-5.9 3.4 0 6 2.4 6 5.6 0 3.7-2.1 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.6c-.2 1-.9 2.2-1.4 2.9A10 10 0 1012 2z'
 };

 $('socialRow').innerHTML = Object.entries({
  instagram: S.instagram, tiktok: S.tiktok, x: S.x,
  threads: S.threads, facebook: S.facebook, pinterest: S.pinterest
 }).map(([k, u]) => `
