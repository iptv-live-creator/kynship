/* ===== بيانات التواصل ===== */
$('btnOpenSettings').onclick = () => {
 const S = C.contact || {};
 $('set_wa').value = S.whatsapp || '';
 $('set_ig').value = S.instagram || '';
 $('set_tt').value = S.tiktok || '';
 $('set_fb').value = S.facebook || '';
 $('set_x').value = S.x || '';
 $('set_th').value = S.threads || '';
 $('set_pin').value = S.pinterest || '';
 openModal('settingsModal');
};

function saveSettingsModal(e) {
 e.preventDefault();
 C.contact = C.contact || {};
 C.contact.whatsapp = $('set_wa').value.trim();
 C.contact.instagram = $('set_ig').value.trim();
 C.contact.tiktok = $('set_tt').value.trim();
 C.contact.facebook = $('set_fb').value.trim();
 C.contact.x = $('set_x').value.trim();
 C.contact.threads = $('set_th').value.trim();
 C.contact.pinterest = $('set_pin').value.trim();
 markDirty();
 renderFooter();
 closeModal('settingsModal');
 toast('تم حفظ بيانات التواصل والروابط ✓');
}

/* ===== محرك الربط المباشر مع GitHub و Netlify ===== */
function getGitHubConfig() {
 try {
  const c = localStorage.getItem('kyn_gh_config');
  return c ? JSON.parse(c) : {};
 } catch(e) { return {}; }
}

function openGitHubModal() {
 const cfg = getGitHubConfig();
 if (cfg.repo) $('gh_repo').value = cfg.repo;
 if (cfg.branch) $('gh_branch').value = cfg.branch;
 if (cfg.token) $('gh_token').value = cfg.token;
 $('ghTestStatus').style.display = 'none';
 openModal('githubModal');
}

function toggleTokenVisibility() {
 const inp = $('gh_token');
 inp.type = (inp.type === 'password') ? 'text' : 'password';
}

function saveGitHubSettings(e) {
 if (e) e.preventDefault();
 const repo = $('gh_repo').value.trim();
 const branch = $('gh_branch').value.trim() || 'main';
 const token = $('gh_token').value.trim();
 if (!repo || !token) return alert('يرجى كتابة اسم المستودع والرمز');
 localStorage.setItem('kyn_gh_config', JSON.stringify({ repo, branch, token }));
 closeModal('githubModal');
 toast('تم حفظ إعدادات GitHub بنجاح! جاهز للنشر المباشر ✓');
}

async function testGitHubConnection() {
 const repo = $('gh_repo').value.trim();
 const branch = $('gh_branch').value.trim() || 'main';
 const token = $('gh_token').value.trim();
 const st = $('ghTestStatus');
 st.style.display = 'block';
 st.style.background = 'rgba(255,255,255,0.06)';
 st.style.color = '#F4F1E8';
 st.textContent = 'جاري فحص الاتصال بـ GitHub…';

 if (!repo || !token) {
  st.style.color = '#ff6b6b';
  st.textContent = 'يرجى كتابة اسم المستودع والرمز أولاً';
  return;
 }

 try {
  const res = await fetch('https://api.github.com/repos/' + repo, {
   headers: {
    Authorization: 'Bearer ' + token,
    Accept: 'application/vnd.github.v3+json'
   }
  });
  if (res.ok) {
   const data = await res.json();
   st.style.color = '#25D366';
   st.textContent = '✓ الاتصال ناجح بمستودع: ' + data.full_name + ' (' + (data.private ? 'خاص' : 'عام') + ')';
  } else {
   st.style.color = '#ff6b6b';
   st.textContent = '❌ فشل الاتصال (' + res.status + '): تأكد من صحة اسم المستودع وصلاحية الرمز';
  }
 } catch(err) {
  st.style.color = '#ff6b6b';
  st.textContent = '❌ خطأ في الاتصال: ' + err.message;
 }
}

/* ===== حفظ ونشر التعديلات (محلياً + GitHub + Netlify) ===== */
$('btnSaveAdmin').onclick = saveChanges;

async function saveChanges() {
 const btn = $('btnSaveAdmin');
 btn.disabled = true;
 btn.textContent = 'جاري الحفظ…';
 toast('جاري حفظ التعديلات…', 3000);

 // 1. الحفظ في المتصفح فوراً للمزامنة اللحظية
 try {
  localStorage.setItem('kyn_content', JSON.stringify(C));
  window.dispatchEvent(new Event('storage'));
 } catch(e) {}

 const isLocal = (location.hostname === 'localhost' || location.hostname === '127.0.0.1');
 const gh = getGitHubConfig();

 // 2. إذا كنا على السيرفر المحلي، احفظ على القرص في content.json
 if (isLocal) {
  try {
   await fetch('upload.php', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Mode': 'save' },
    body: JSON.stringify(C)
   });
  } catch(e) {}
 }

 // 3. إذا تم ضبط GitHub، انشر التعديلات مباشرة إلى مستودع GitHub
 if (gh.repo && gh.token) {
  btn.textContent = 'جاري النشر لـ GitHub…';
  toast('جاري إرسال التعديل إلى مستودع GitHub…', 4000);
  try {
   const branch = gh.branch || 'main';
   let sha;
   try {
    const shaRes = await fetch('https://api.github.com/repos/' + gh.repo + '/contents/content.json?ref=' + branch, {
     headers: { Authorization: 'Bearer ' + gh.token, Accept: 'application/vnd.github.v3+json' }
    });
    if (shaRes.ok) {
     const shaData = await shaRes.json();
     sha = shaData.sha;
    }
   } catch(e) {}

   const jsonString = JSON.stringify(C, null, 2);
   const base64Content = btoa(unescape(encodeURIComponent(jsonString)));

   const putRes = await fetch('https://api.github.com/repos/' + gh.repo + '/contents/content.json', {
    method: 'PUT',
    headers: {
     Authorization: 'Bearer ' + gh.token,
     Accept: 'application/vnd.github.v3+json',
     'Content-Type': 'application/json'
    },
    body: JSON.stringify({
     message: 'Update content via Kynship Live CMS',
     content: base64Content,
     sha: sha,
     branch: branch
    })
   });

   if (putRes.ok) {
    clearDirty();
    toast('تم الحفظ ونشر التعديل إلى GitHub بنجاح! سيقوم Netlify بتحديث الموقع تلقائياً خلال ثوانٍ معدودة ✓', 5000);
    return;
   } else {
    const errData = await putRes.json();
    clearDirty();
    toast('تم الحفظ محلياً — تعذر النشر إلى GitHub: ' + (errData.message || putRes.status), 6000);
    return;
   }
  } catch(err) {
   clearDirty();
   toast('تم الحفظ محلياً — خطأ في اتصال GitHub: ' + err.message, 5000);
   return;
  }
 }

 // في حال لم نكن محلياً ولم يتم إدخال إعدادات GitHub بعد
 if (!isLocal && (!gh.repo || !gh.token)) {
  clearDirty();
  toast('تم الحفظ بالمتصفح! يرجى إدخال إعدادات GitHub لنشر التعديل لكل الزوار على Netlify', 5000);
  openGitHubModal();
  return;
 }

 clearDirty();
 toast('تم الحفظ بنجاح! التعديلات تم تطبيقها على الموقع والصفحة الثانية فوراً ✓', 4000);
}

/* ===== مختبر التصميم التفاعلي ===== */
const WA = C.contact?.whatsapp || '201010104140';
const cols = [["كحلي","#1F3A5F"],["أخضر زيتي","#1F4A44"],["بيج","#D8CDB8"],["أبيض","#EEEAE2"],["رمادي","#6B6F76"],["خشب","#8A5A33"]];
const tops = [["رخام فاتح","#E9E6E0"],["جرانيت داكن","#2B2B2E"],["خشب","#A8743F"]];
const StudioState = { c: 0, t: 0, h: 0, w: 3.5, l: 0, a: new Set() };

function chips(id, arr, key) {
 const el = $(id); el.innerHTML = "";
 arr.forEach((n, i) => {
  const b = document.createElement("button");
  b.textContent = n;
  b.setAttribute("aria-pressed", StudioState[key] === i);
  b.onclick = () => { StudioState[key] = i; chips(id, arr, key); drawStudio(); };
  el.appendChild(b);
 });
}

function multiChips() {
 const el = $("ch4"); el.innerHTML = "";
 ["مُنظّم أدراج","رف رفع للأعلى","إضاءة LED","شفاط"].forEach(n => {
  const b = document.createElement("button");
  b.textContent = n;
  b.setAttribute("aria-pressed", StudioState.a.has(n));
  b.onclick = () => {
   StudioState.a.has(n) ? StudioState.a.delete(n) : StudioState.a.add(n);
   multiChips(); drawStudio();
  };
  el.appendChild(b);
 });
}

function swatches() {
 const el = $("sw1"); el.innerHTML = "";
 cols.forEach((c, i) => {
  const b = document.createElement("button");
  b.style.background = c[1];
  b.title = c[0];
  b.setAttribute("aria-label", c[0]);
  b.setAttribute("aria-pressed", StudioState.c === i);
  b.onclick = () => { StudioState.c = i; swatches(); drawStudio(); };
  el.appendChild(b);
 });
}

let S_txt = '';
function drawStudio() {
 const n = Math.max(3, Math.round(StudioState.w * 1.6)), W = 520, mw = W / n;
 const c = cols[StudioState.c][1], t = tops[StudioState.t][1];
 let s = '<rect width="600" height="380" fill="#0F2B4C"/><rect x="0" y="300" width="600" height="80" fill="#0a1a2e"/>';
 const hnd = (x, y, v) => StudioState.h == 0 ? `<rect x="${x}" y="${y}" width="3" height="${v?26:30}" rx="1.5" fill="#F5B800"/>` : StudioState.h == 1 ? `<circle cx="${x+1}" cy="${y+10}" r="4" fill="#F5B800"/>` : "";
 const uh = StudioState.l == 2 ? 150 : 110;
 for (let i = 0; i < n; i++) {
  const x = 40 + i * mw;
  s += `<rect x="${x+2}" y="40" width="${mw-4}" height="${uh}" rx="3" fill="${c}" stroke="rgba(0,0,0,.35)"/>` + hnd(x + mw - 14, uh + 4, 1);
  s += `<rect x="${x+2}" y="208" width="${mw-4}" height="92" rx="3" fill="${c}" stroke="rgba(0,0,0,.35)"/>` + hnd(x + mw - 14, 214, 0);
 }
 s += `<rect x="34" y="196" width="${W+12}" height="12" fill="${t}"/>`;
 if (StudioState.t == 0) s += `<path d="M60 198 l40 6 M200 197 l30 8 M380 198 l50 6" stroke="#b9b4a8" stroke-width="1"/>`;
 if (StudioState.a.has("إضاءة LED")) s += `<rect x="44" y="${40+uh+2}" width="${W-8}" height="3" fill="#F5B800" opacity=".9"/>`;
 if (StudioState.a.has("شفاط")) s += `<path d="M${40+W/2-50} 40 l20 -22 h60 l20 22z" fill="#9FB3CC"/>`;
 if (StudioState.a.has("رف رفع للأعلى")) s += `<rect x="42" y="${uh+44}" width="16" height="3" fill="#F5B800"/>`;
 if (StudioState.l == 1) s += `<rect x="${40+W/2-110}" y="318" width="220" height="46" rx="4" fill="${c}"/><rect x="${40+W/2-118}" y="308" width="236" height="12" fill="${t}"/>`;
 $("kv").innerHTML = s;
 $("wv").textContent = StudioState.w;
 const L = ["خطي","جزيرة","علوي مرتفع"][StudioState.l], H = ["مقبض بار","مقبض كُنب","بدون مقبض"][StudioState.h];
 S_txt = `مطبخ ${StudioState.w} متر – لون ${cols[StudioState.c][0]} – رخامة ${tops[StudioState.t][0]} – ${H} – تقسيم ${L}` + (StudioState.a.size ? " – ملحقات: " + [...StudioState.a].join("، ") : "");
 $("sum").innerHTML = "<b>اختياراتك:</b> " + S_txt;
}

function initStudio() {
 swatches();
 chips("ch1", tops.map(x => x[0]), "t");
 chips("ch2", ["مقبض بار","مقبض كُنب","بدون مقبض"], "h");
 chips("ch3", ["خطي","جزيرة","علوي مرتفع"], "l");
 multiChips();
 drawStudio();
 $("wd").oninput = e => { StudioState.w = +e.target.value; drawStudio(); };
 $("send").onclick = e => {
  e.preventDefault();
  $("ms").value = "تصميمي: " + S_txt;
  $("contact").scrollIntoView({ behavior: 'smooth' });
 };
}

/* ===== تهيئة وتحميل بيانات الموقع بالكامل (Boot) ===== */
async function boot() {
 if (!isLogged()) {
  $('kynLoginOverlay').style.display = 'flex';
 }

 try {
  const local = localStorage.getItem('kyn_content');
  if (local) {
   C = JSON.parse(local);
  } else {
   C = await fetch('content.json?v=' + Date.now(), { cache: 'no-store' }).then(r => r.json());
  }
 } catch(e) {
  try { C = await fetch('content.json', { cache: 'no-store' }).then(r => r.json()); } catch(e2){}
 }

 document.title = 'Kynship | لوحة التعديل المباشر';

 // 1. تحميل الخطوط المخصصة
 loadCustomFonts(C.customFonts);
 populateFontDropdowns();

 if (C.globalFont) {
  document.body.style.fontFamily = "'" + C.globalFont + "', Cairo, Tahoma, sans-serif";
 }

 // 2. تعبئة النصوص
 document.querySelectorAll('[data-k]').forEach(el => {
  const k = el.getAttribute('data-k');
  const v = getVal(k);
  if (v != null) {
   if (k.includes('tagline_en')) {
    el.innerHTML = v;
   } else {
    el.textContent = v;
   }
  }
 });

 // 3. تعبئة القائمة العلوية Nav
 if (C.nav) {
  $('navList').innerHTML = C.nav.map((n, i) => `
   <li><a href="${n.href}" data-k="nav.${i}.label" contenteditable="true">${esc(n.label)}</a></li>
  `).join('');
 }

 // 4. نصوص القصة والبانر والأعمال
 $('storyTitle').textContent = C.story?.title || 'قصة Kynship';
 $('storyText').textContent = C.story?.text || '';
 $('storyCta').textContent = C.story?.cta || 'اعرف أكتر';
 $('bannerCta').textContent = C.banner?.cta || 'أحدث الأعمال';
 $('bannerCta').href = C.banner?.href || '#proj';

 // 5. صور الأقسام والبانر والمشاريع
 renderImages();

 // 6. المميزات
 renderFeatures();

 // 7. الفوتر
 renderFooter();

 // 8. استوديو التصميم
 initStudio();

 // 9. نموذج التواصل
 if (C.contact_section?.types) {
  $('ty').innerHTML = C.contact_section.types.map(t => `<option>${esc(t)}</option>`).join('');
 }
 $('nm').placeholder = C.contact_section?.name_ph || 'الاسم';
 $('ph2').placeholder = C.contact_section?.phone_ph || 'رقم الموبايل';
 $('ms').placeholder = C.contact_section?.msg_ph || 'تفاصيل إضافية…';

 // 10. تطبيق التنسيقات المخصصة
 applyAllStyles(C.styles);

 // 11. تفعيل التعديل المباشر
 bindInlineTextEditing();
}

boot();
</script>
</body>
</html>