<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kynship | لوحة التعديل المباشر</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;600;700&family=Almarai:wght@300;400;700&family=Amiri:wght@400;700&family=Cairo:wght@300;400;600;700;900&family=Changa:wght@400;600;700&family=Inter:wght@300;400;600;700&family=Noto+Kufi+Arabic:wght@300;400;600;700&family=Outfit:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Readex+Pro:wght@300;400;600;700&family=Tajawal:wght@300;400;500;700&display=swap">
<style>
/* ==================== أنماط الموقع الأساسية (مطابقة 100% لـ index.html) ==================== */
:root{--bg:#FFFFFF;--soft:#F4F1EA;--ink:#0A1E36;--mute:#5d6b7d;--line:rgba(10,30,54,.14);--navy:#0A1E36;--navy2:#0F2B4C;--card:#12335a;--on:#F4F1E8;--nm:#9FB3CC;--gold:#F5B800;--gd:#8a6700;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0A1E36;--soft:#0F2B4C;--ink:#F4F1E8;--mute:#9FB3CC;--line:rgba(244,241,232,.16)}}
:root[data-theme="dark"]{--bg:#0A1E36;--soft:#0F2B4C;--ink:#F4F1E8;--mute:#9FB3CC;--line:rgba(244,241,232,.16)}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:140px}
body{background:var(--bg);color:var(--ink);font-family:Cairo,Tahoma,sans-serif;line-height:1.8;font-weight:400;padding-top:54px}
a{color:inherit}
.w{max-width:1180px;margin:auto;padding:0 24px}
.bar{background:var(--navy);color:var(--gold);text-align:center;font-size:13px;padding:8px 12px;position:relative}
nav{position:sticky;top:54px;z-index:90;background:var(--bg);border-bottom:1px solid var(--line);box-shadow:0 2px 10px rgba(0,0,0,.03)}
nav .w{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font-weight:900;font-size:22px;letter-spacing:.45em;text-decoration:none}
nav ul{display:flex;gap:30px;list-style:none;padding:0;align-items:center}
nav ul a{text-decoration:none;font-size:15px}
nav ul a:hover,nav ul a:focus-visible{color:var(--gd)}
.btn{display:inline-block;background:var(--gold);color:#0A1E36;padding:11px 28px;border:0;border-radius:30px;cursor:pointer;text-decoration:none;font:600 15px Cairo,sans-serif;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(245,184,0,.25)}
.btn.d{background:var(--navy);color:var(--on)}
.btn.o{background:none;color:var(--on);border:1px solid rgba(244,241,232,.4)}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.hero{background:radial-gradient(900px 420px at 80% 0,#235b96 0,transparent 70%),linear-gradient(160deg,#0F2B4C,#081628);color:var(--on);text-align:center;padding:130px 0 120px;position:relative}
.hero h1{font-size:clamp(38px,7vw,80px);font-weight:300;line-height:1.15;letter-spacing:.02em}
.hero h1 b{display:block;font-weight:900;color:var(--gold)}
.hero p{color:var(--nm);margin:20px auto 30px;max-width:48ch}
.hero .cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
section{padding:72px 0;position:relative}
h2{font-size:clamp(24px,3.4vw,34px);font-weight:600;text-align:center;margin-bottom:34px}
.cats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.cats .cat-item{text-decoration:none;text-align:center;position:relative;display:block}
.cats i{display:block;aspect-ratio:3/4;margin-bottom:10px;border-radius:4px;background-size:cover;background-position:center;transition:transform .25s;position:relative;overflow:hidden}
.cats .cat-item:hover i{transform:translateY(-4px)}
.strip{background:var(--soft);padding:54px 0;position:relative}
.strip .w{display:grid;grid-template-columns:repeat(3,1fr);gap:34px}
.strip>div{display:flex;gap:16px;align-items:flex-start;position:relative}
.strip svg{width:44px;height:44px;flex:none;fill:none;stroke:var(--gd);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.strip h3{font-size:18px;margin-bottom:4px}
.strip p{color:var(--mute);font-size:14px}
.story .w{display:grid;grid-template-columns:1.1fr 1fr;gap:44px;align-items:center}
.ph{border-radius:4px;background-size:cover;background-position:center;min-height:380px;position:relative}
.story h2{text-align:right}
.story p{color:var(--mute);margin-bottom:22px}
.banner{position:relative;min-height:380px;display:grid;place-items:end center;padding:40px;background-size:cover;background-position:center}
.banner::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,20,38,.15),rgba(8,20,38,.75))}
.banner .btn{position:relative;z-index:2}
.proj .w{display:grid;grid-template-columns:1.1fr 1.1fr;gap:36px;align-items:center}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.card{background:var(--bg);border:1px solid var(--line);border-radius:4px;overflow:hidden;transition:transform .25s,box-shadow .25s;position:relative}
.card:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(10,30,54,.12)}
.card .ph{min-height:230px}
.card .tx{padding:16px 18px 20px}
.card h3{font-size:17px;margin-bottom:4px}
.card p{color:var(--mute);font-size:14px}
.proj .lead h2{text-align:right}
.proj .lead p{color:var(--mute)}
.lab{background:var(--navy);color:var(--on);position:relative}
.lab .sub{color:var(--nm);text-align:center;max-width:60ch;margin:-16px auto 30px}
.cust{display:grid;grid-template-columns:1.3fr 1fr;gap:28px}
.stage svg{width:100%;height:auto;border-radius:3px}
.panel{background:var(--soft);color:var(--ink);border-radius:4px;padding:24px;display:flex;flex-direction:column;gap:18px}
.panel .pl{font-size:13px;font-weight:600;color:var(--mute);display:block;margin-bottom:8px}
.sw{display:flex;gap:10px;flex-wrap:wrap}
.sw button{width:34px;height:34px;border-radius:50%;border:2px solid var(--line);cursor:pointer}
.sw button[aria-pressed="true"]{border-color:var(--navy);box-shadow:0 0 0 2px var(--gold)}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chips button{background:var(--bg);border:1px solid var(--line);border-radius:20px;padding:7px 14px;font:400 13px Cairo,sans-serif;cursor:pointer;color:var(--ink)}
.chips button[aria-pressed="true"]{background:var(--navy);color:var(--on);border-color:var(--navy)}
.panel input[type=range]{width:100%;accent-color:var(--gold)}
.panel label{font-size:14px}
.sum{font-size:13px;color:var(--mute);border-top:1px dashed var(--line);padding-top:12px;min-height:20px}
.contact{background:var(--soft);position:relative}
form{display:grid;gap:12px;max-width:560px;margin:auto}
form input,form select,form textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:3px;background:var(--bg);color:var(--ink);font:400 15px Cairo,sans-serif}
form textarea{resize:vertical}
footer{background:var(--navy);color:var(--nm);padding:54px 0 26px;position:relative}
footer .w{display:grid;grid-template-columns:repeat(4,1fr);gap:30px}
footer h4{color:var(--on);font-size:15px;margin-bottom:12px}
footer a{display:block;text-decoration:none;font-size:14px;padding:3px 0}
footer a:hover{color:var(--gold)}
.social{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px}
.social a{width:38px;height:38px;border:1px solid rgba(244,241,232,.25);border-radius:50%;display:grid;place-items:center;padding:0}
.social a:hover{border-color:var(--gold)}
.social svg{width:17px;height:17px;fill:currentColor}
.cp{border-top:1px solid rgba(244,241,232,.14);margin-top:34px;padding-top:18px;text-align:center;font-size:13px}
.fab{position:fixed;bottom:22px;left:22px;z-index:80;width:54px;height:54px;border-radius:50%;background:#25D366;color:#fff;display:grid;place-items:center;box-shadow:0 8px 22px rgba(0,0,0,.28);text-decoration:none}
.fab svg{width:28px;height:28px;fill:currentColor}

@media(max-width:900px){
 .cats{grid-template-columns:repeat(2,1fr)}
 .strip .w{grid-template-columns:1fr}
 .story .w,.proj .w,.cust{grid-template-columns:1fr}
 footer .w{grid-template-columns:repeat(2,1fr)}
 nav ul{display:none}
}

/* ==================== طبقة التحكم والتعديل والتنسيقات والخطوط ==================== */
#kynAdminBar{
 position:fixed;top:0;left:0;right:0;height:54px;z-index:99999;
 background:linear-gradient(90deg,#071526,#0A1E36 50%,#0e2a4a);
 color:#F4F1E8;border-bottom:2px solid var(--gold);
 display:flex;align-items:center;padding:0 18px;
 box-shadow:0 4px 20px rgba(0,0,0,.4);
 font-family:Cairo,sans-serif;
}
.kyn-bar-w{display:flex;align-items:center;justify-content:space-between;width:100%;gap:12px}
.kyn-bar-left{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.kyn-brand{font-weight:900;letter-spacing:.25em;color:var(--gold);font-size:15px}
.kyn-badge{background:rgba(245,184,0,.18);border:1px solid var(--gold);color:var(--gold);font-size:11px;font-weight:600;padding:2px 8px;border-radius:12px}
.kyn-dirty-pill{font-size:12px;color:#9FB3CC;display:flex;align-items:center;gap:6px}
.kyn-dirty-pill.has-changes{color:#ff9800;font-weight:700}
.kyn-dirty-pill.has-changes::before{content:"";width:8px;height:8px;background:#ff9800;border-radius:50%;animation:pulse 1.4s infinite}
@keyframes pulse{0%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.2)}100%{opacity:1;transform:scale(1)}}

.kyn-bar-actions{display:flex;align-items:center;gap:8px}
.kyn-bar-btn{
 background:rgba(255,255,255,.08);color:#F4F1E8;border:1px solid rgba(255,255,255,.18);
 padding:6px 14px;border-radius:20px;cursor:pointer;font:600 12px Cairo,sans-serif;
 display:flex;align-items:center;gap:6px;transition:all .2s;text-decoration:none
}
.kyn-bar-btn:hover{background:rgba(255,255,255,.16);border-color:var(--gold);color:var(--gold)}
.kyn-bar-btn.active{background:var(--gold);color:#0A1E36;border-color:var(--gold)}
.kyn-bar-btn.save-btn{background:var(--gold);color:#0A1E36;border:0;font-weight:700}
.kyn-bar-btn.save-btn:disabled{opacity:.4;cursor:not-allowed;background:rgba(245,184,0,.25);color:#9FB3CC}
.kyn-bar-btn.logout-btn{background:transparent;border-color:rgba(255,100,100,.3);color:#ff9e9e}
.kyn-bar-btn.logout-btn:hover{background:rgba(255,80,80,.2);border-color:#ff4d4d;color:#fff}

/* تمييز العناصر القابلة للتعديل */
body.kyn-edit-mode [data-k]{
 position:relative;cursor:text;
 border-radius:3px;transition:background .2s,outline .2s;
}
body.kyn-edit-mode [data-k]:hover{
 outline:1.5px dashed var(--gold);outline-offset:2px;
 background:rgba(245,184,0,.08);
}
body.kyn-edit-mode [data-k]:focus{
 outline:2px solid var(--gold);outline-offset:2px;
 background:rgba(245,184,0,.14);
}

/* شريط تنسيق النصوص المرئي العائم */
#kynTextFormatBar{
 position:fixed;z-index:99998;
 background:#0A1E36;color:#F4F1E8;border:1px solid var(--gold);
 border-radius:24px;padding:4px 10px;display:none;align-items:center;gap:6px;
 box-shadow:0 8px 25px rgba(0,0,0,.45);font-family:Cairo,sans-serif;font-size:12px;
 transform:translateX(-50%);animation:fadeIn .15s ease-out;
}
@keyframes fadeIn{from{opacity:0;transform:translate(-50%,5px)}to{opacity:1;transform:translate(-50%,0)}}
.kyn-fmt-btn{
 background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);
 color:#fff;border-radius:14px;padding:3px 8px;cursor:pointer;font:600 12px Cairo,sans-serif;
 display:flex;align-items:center;justify-content:center;transition:all .15s;
}
.kyn-fmt-btn:hover{background:var(--gold);color:#0A1E36;border-color:var(--gold)}
.kyn-color-circle{
 width:18px;height:18px;border-radius:50%;border:1.5px solid #fff;cursor:pointer;
 display:inline-block;transition:transform .15s;
}
.kyn-color-circle:hover{transform:scale(1.25);border-color:var(--gold)}
.kyn-color-input{
 width:24px;height:24px;border:0;border-radius:50%;cursor:pointer;background:none;padding:0;
}

/* زر تنسيق خلفية الكونتينر / الأقسام */
.kyn-sec-styler-btn{
 display:none;position:absolute;top:14px;left:18px;z-index:40;
 background:rgba(10,30,54,.9);backdrop-filter:blur(6px);color:var(--gold);
 border:1px solid var(--gold);border-radius:20px;padding:5px 12px;
 font:700 12px Cairo,sans-serif;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.25);
 transition:all .2s;align-items:center;gap:6px;
}
.kyn-sec-styler-btn:hover{background:var(--gold);color:var(--navy);transform:scale(1.05)}
body.kyn-edit-mode .kyn-sec-styler-btn{display:flex}

/* أزرار تغيير الصور العائمة مع مقاس كل حاوية */
.kyn-img-overlay-btn{
 display:none;position:absolute;top:10px;right:10px;z-index:25;
 background:rgba(10,30,54,.94);backdrop-filter:blur(8px);
 color:var(--gold);border:1px solid var(--gold);
 padding:6px 14px;border-radius:24px;font:700 12px Cairo,sans-serif;
 cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.4);transition:all .2s;
 align-items:center;gap:8px;
}
.kyn-img-overlay-btn:hover{
 background:var(--gold);color:var(--navy);transform:translateY(-1px);
 box-shadow:0 6px 20px rgba(245,184,0,.35);
}
.kyn-size-tag{
 background:rgba(245,184,0,.22);color:#fff;border:1px solid rgba(245,184,0,.55);
 font-size:11px;font-weight:700;padding:2px 8px;border-radius:12px;
 direction:ltr;letter-spacing:.3px;
}
.kyn-img-overlay-btn:hover .kyn-size-tag{
 background:rgba(10,30,54,.3);color:var(--navy);border-color:rgba(10,30,54,.5);
}
body.kyn-edit-mode .has-img-edit:hover .kyn-img-overlay-btn,
body.kyn-edit-mode .banner:hover .kyn-img-overlay-btn,
body.kyn-edit-mode .story .ph:hover .kyn-img-overlay-btn,
body.kyn-edit-mode .cat-item:hover .kyn-img-overlay-btn,
body.kyn-edit-mode .card:hover .kyn-img-overlay-btn{
 display:flex !important;
}

/* بطاقات التحكم في القوائم */
.kyn-item-ctrls{
 display:none;position:absolute;top:8px;left:8px;z-index:30;
 background:rgba(10,30,54,.92);padding:4px;border-radius:20px;
 border:1px solid var(--line);box-shadow:0 4px 12px rgba(0,0,0,.3);
 gap:4px;
}
body.kyn-edit-mode .cat-item:hover .kyn-item-ctrls,
body.kyn-edit-mode .card:hover .kyn-item-ctrls,
body.kyn-edit-mode .strip-item:hover .kyn-item-ctrls{
 display:flex;
}
.kyn-ctrl-btn{
 width:24px;height:24px;border-radius:50%;border:0;cursor:pointer;
 display:flex;align-items:center;justify-content:center;font-size:11px;
 font-weight:700;line-height:1;transition:all .15s;
}
.kyn-ctrl-del{background:#dc3545;color:#fff}
.kyn-ctrl-del:hover{background:#ff1e32;transform:scale(1.1)}
.kyn-ctrl-mv{background:var(--card);color:var(--on);border:1px solid rgba(255,255,255,.2)}
.kyn-ctrl-mv:hover{background:var(--gold);color:var(--navy)}

/* أزرار الإضافة داخل الشبكات */
.kyn-add-card{
 display:none;border:2px dashed var(--gd);border-radius:6px;
 background:rgba(245,184,0,.04);color:var(--gd);
 cursor:pointer;font:700 14px Cairo,sans-serif;
 flex-direction:column;align-items:center;justify-content:center;
 gap:8px;padding:24px;transition:all .2s;min-height:160px;
}
body.kyn-edit-mode .kyn-add-card{display:flex}
.kyn-add-card:hover{background:rgba(245,184,0,.12);border-color:var(--gold);color:var(--navy);transform:translateY(-3px)}
.kyn-add-card span.plus{font-size:28px;line-height:1}

/* المودال — ستايل داكن فخم موحد ومتناسق 100% */
.kyn-modal{
 position:fixed;inset:0;z-index:999999;
 background:rgba(4,12,24,.88);backdrop-filter:blur(12px);
 display:none;align-items:center;justify-content:center;padding:16px;
}
.kyn-modal.show{display:flex}
.kyn-modal-box{
 background:linear-gradient(170deg,#0D233C 0%,#071628 100%);
 color:#F4F1E8;border-radius:12px;
 border:1px solid rgba(245,184,0,.3);
 box-shadow:0 24px 60px rgba(0,0,0,.65), 0 0 1px 1px rgba(245,184,0,.2);
 max-width:640px;width:100%;max-height:90vh;overflow-y:auto;position:relative;
 padding:26px;font-family:Cairo,sans-serif;
}
.kyn-modal-header{
 display:flex;justify-content:space-between;align-items:center;
 margin-bottom:18px;border-bottom:1px solid rgba(255,255,255,.12);
 padding-bottom:12px;
}
.kyn-modal-header h3{
 font-size:18px;font-weight:700;color:var(--gold);
 display:flex;align-items:center;gap:8px;margin:0;
}
.kyn-modal-close{
 background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);
 font-size:20px;cursor:pointer;color:#9FB3CC;line-height:1;
 width:32px;height:32px;border-radius:50%;display:grid;place-items:center;
 transition:all .2s;
}
.kyn-modal-close:hover{
 background:rgba(245,184,0,.15);border-color:var(--gold);color:var(--gold);
 transform:rotate(90deg);
}
.kyn-fit-card{
 transition:all .2s;
}
.kyn-fit-card:hover{
 border-color:rgba(245,184,0,.5) !important;
 transform:translateY(-1px);
}

.kyn-gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}
.kyn-gallery-thumb{
 aspect-ratio:4/3;border-radius:4px;overflow:hidden;border:2px solid transparent;
 cursor:pointer;position:relative;background-size:cover;background-position:center;
 transition:all .2s;
}
.kyn-gallery-thumb:hover{transform:scale(1.04);border-color:var(--gold)}
.kyn-gallery-thumb.selected{border-color:var(--navy);box-shadow:0 0 0 2px var(--gold)}
.kyn-gallery-thumb span{
 position:absolute;bottom:0;inset-inline:0;background:rgba(10,30,54,.8);color:#fff;
 font-size:10px;text-align:center;padding:2px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

/* شاشة تسجيل الدخول */
#kynLoginOverlay{
 position:fixed;inset:0;z-index:9999999;
 background:rgba(8,20,38,.86);backdrop-filter:blur(12px);
 display:flex;align-items:center;justify-content:center;padding:20px;
}
.kyn-login-card{
 background:#fff;color:#0A1E36;border-radius:8px;padding:36px 30px;
 max-width:420px;width:100%;text-align:center;box-shadow:0 24px 60px rgba(0,0,0,.5);
 border-top:4px solid var(--gold);
}
.kyn-login-logo{font-weight:900;letter-spacing:.35em;font-size:24px;color:var(--navy);margin-bottom:6px}
.kyn-login-card h2{font-size:20px;margin-bottom:8px;font-weight:700}
.kyn-login-card p{color:var(--mute);font-size:13px;margin-bottom:22px}
.kyn-login-card input{
 width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:4px;
 margin-bottom:14px;text-align:center;font:600 15px Cairo,sans-serif;background:var(--soft);
}
.kyn-login-card button{width:100%;padding:12px;font-size:15px;font-weight:700}

#kynToast{
 position:fixed;bottom:24px;right:24px;z-index:999999;
 background:var(--navy);color:var(--on);padding:12px 22px;border-radius:30px;
 font:600 13px Cairo,sans-serif;box-shadow:0 10px 30px rgba(0,0,0,.35);
 border:1px solid var(--gold);display:none;align-items:center;gap:10px;
}
</style>
</head>
<body class="kyn-edit-mode">

<!-- شريط لوحة التحكم العلوي الثابت -->
<div id="kynAdminBar">
 <div class="kyn-bar-w">
  <div class="kyn-bar-left">
   <span class="kyn-brand">KYNSHIP</span>
   <span class="kyn-badge">لوحة التعديل المباشر</span>
   <span id="kynDirtyIndicator" class="kyn-dirty-pill">كل التعديلات محفوظة ✓</span>
  </div>
  <div class="kyn-bar-actions">
   <button type="button" class="kyn-bar-btn mode-btn active" id="btnToggleMode" title="تبديل بين التعديل ومعاينة الزائر">
    <span id="modeIcon">✏️</span> <span id="modeText">وضع التعديل</span>
   </button>
   <button type="button" class="kyn-bar-btn" id="btnOpenFonts" onclick="openModal('fontManagerModal')" title="تغيير خطوط الموقع وإضافة خطوط جديدة">
    🔤 خطوط الموقع
   </button>
   <button type="button" class="kyn-bar-btn" id="btnOpenSettings">
    ⚙️ بيانات التواصل & الروابط
   </button>
   <button type="button" class="kyn-bar-btn save-btn" id="btnSaveAdmin" disabled>
    💾 حفظ ونشر التعديلات
   </button>
   <a href="index.html" target="_blank" class="kyn-bar-btn link-btn" title="فتح الموقع للزوار في نافذة جديدة">
    🌐 معاينة كزائر
   </a>
   <button type="button" class="kyn-bar-btn logout-btn" id="btnLogoutAdmin">
    خروج
   </button>
  </div>
 </div>
</div>

<!-- شريط تنسيق النصوص العائم السريع (Floating Text Formatting Toolbar) -->
<div id="kynTextFormatBar">
 <span style="font-weight:700;color:var(--gold);font-size:11px">تنسيق النص:</span>
 <select id="textFontSelect" class="kyn-fmt-btn" style="padding:2px 8px;max-width:130px;background:#0F2B4C;color:#fff;border-color:var(--gold);cursor:pointer" onchange="handleFontSelectChange(this.value)">
 </select>
 <span style="border-right:1px solid rgba(255,255,255,.2);height:14px;margin:0 2px"></span>
 <button type="button" class="kyn-fmt-btn" title="تصغير الخط" onclick="adjustFontSize(-2)">A-</button>
 <span id="currentFontSizeLbl" style="font-size:11px;color:#fff;min-width:24px;text-align:center">16px</span>
 <button type="button" class="kyn-fmt-btn" title="تكبير الخط" onclick="adjustFontSize(2)">A+</button>
 <span style="border-right:1px solid rgba(255,255,255,.2);height:14px;margin:0 2px"></span>
 <button type="button" class="kyn-fmt-btn" title="عريض Bold" onclick="toggleFontWeight()">B</button>
 <span style="border-right:1px solid rgba(255,255,255,.2);height:14px;margin:0 2px"></span>
 <span class="kyn-color-circle" style="background:#F5B800" title="ذهبي" onclick="applyTextColor('#F5B800')"></span>
 <span class="kyn-color-circle" style="background:#0A1E36" title="كحلي" onclick="applyTextColor('#0A1E36')"></span>
 <span class="kyn-color-circle" style="background:#FFFFFF" title="أبيض" onclick="applyTextColor('#FFFFFF')"></span>
 <span class="kyn-color-circle" style="background:#9FB3CC" title="رمادي ناعم" onclick="applyTextColor('#9FB3CC')"></span>
 <span class="kyn-color-circle" style="background:#111111" title="أسود" onclick="applyTextColor('#111111')"></span>
 <input type="color" id="freeTextColorPicker" class="kyn-color-input" title="لون مخصص" onchange="applyTextColor(this.value)">
 <span style="border-right:1px solid rgba(255,255,255,.2);height:14px;margin:0 2px"></span>
 <button type="button" class="kyn-fmt-btn" title="استعادة التنسيق الافتراضي" onclick="resetCurrentTextStyle()">↺</button>
</div>

<!-- ==================== هيكل الموقع الأساسي (نفس index.html تماماً) ==================== -->

<!-- 1. الشريط العلوي -->
<div class="bar" id="topBar" data-k="brand.bar" contenteditable="true" title="اضغط للتعديل المباشر">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('topBar')">🎨 لون البار</button>
 <span>ضمان لحد 10 سنين · استشارة تصميم مجانية</span>
</div>

<!-- 2. النافبار -->
<nav id="mainNav">
 <div class="w">
  <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('mainNav')">🎨 خلفية النافبار</button>
  <a class="logo" href="#top" data-k="brand.name" contenteditable="true">KYNSHIP</a>
  <ul id="navList"></ul>
  <a class="btn d" href="#contact" id="navCta" data-k="nav_cta" contenteditable="true">اطلب عرض سعر</a>
 </div>
</nav>

<!-- 3. قسم الـ Hero -->
<header class="hero" id="top">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('top')">🎨 خلفية الهيرو</button>
 <div class="w">
  <h1 data-k="brand.tagline_en" contenteditable="true">Precision<b>.in Every Piece</b></h1>
  <p data-k="brand.sub" contenteditable="true">نحوّل أحلامك لواقع بأعلى جودة وأسرع تسليم</p>
  <div class="cta">
   <a class="btn" href="#lab" data-k="hero_cta1" contenteditable="true">صمّم مطبخك</a>
   <a class="btn o" href="#proj" data-k="hero_cta2" contenteditable="true">شوف أعمالنا</a>
  </div>
 </div>
</header>

<!-- 4. قسم اكتشف أقسامنا -->
<section id="cats">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('cats')">🎨 خلفية الأقسام</button>
 <div class="w">
  <h2 data-k="cats_title" contenteditable="true">اكتشف أقسامنا</h2>
  <div class="cats" id="catGrid"></div>
 </div>
</section>

<!-- 5. شريط المميزات -->
<div class="strip" id="featuresStrip">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('featuresStrip')">🎨 خلفية المميزات</button>
 <div class="w" id="featGrid"></div>
</div>

<!-- 6. قسم القصة -->
<section class="story" id="story">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('story')">🎨 خلفية القصة</button>
 <div class="w">
  <div class="ph has-img-edit" id="storyImg" role="img">
   <button type="button" class="kyn-img-overlay-btn" onclick="openImagePicker('story.img')"><span>📷 تغيير الصورة</span><span class="kyn-size-tag">800×600 px</span></button>
  </div>
  <div class="lead">
   <h2 id="storyTitle" data-k="story.title" contenteditable="true">قصة Kynship</h2>
   <p id="storyText" data-k="story.text" contenteditable="true"></p>
   <a class="btn d" href="#contact" id="storyCta" data-k="story.cta" contenteditable="true">اعرف أكتر</a>
  </div>
 </div>
</section>

<!-- 7. البانر الإعلاني -->
<div class="banner has-img-edit" id="banner">
 <button type="button" class="kyn-img-overlay-btn" onclick="openImagePicker('banner.img')"><span>📷 تغيير صورة البانر</span><span class="kyn-size-tag">1920×650 px</span></button>
 <a class="btn" href="#proj" id="bannerCta" data-k="banner.cta" contenteditable="true">أحدث الأعمال</a>
</div>

<!-- 8. قسم الأعمال والمشاريع -->
<section class="proj" id="proj">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('proj')">🎨 خلفية المعرض</button>
 <div class="w">
  <div class="grid2" id="projGrid"></div>
  <div class="lead">
   <h2 id="projHead" data-k="projects_head" contenteditable="true">Projects by Kynship</h2>
   <p id="projSub" data-k="projects_sub" contenteditable="true"></p>
  </div>
 </div>
</section>

<!-- 9. استوديو التصميم التفاعلي (Lab) -->
<section class="lab" id="lab">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('lab')">🎨 خلفية الاستوديو</button>
 <div class="w">
  <h2 id="labTitle" data-k="lab.title" contenteditable="true">استوديو التصميم</h2>
  <p class="sub" id="labSub" data-k="lab.sub" contenteditable="true"></p>
  <div class="cust">
   <div class="stage"><svg id="kv" viewBox="0 0 600 380" role="img" aria-label="معاينة المطبخ"></svg></div>
   <div class="panel" id="labPanel">
    <div><span class="pl">لون الدواليب</span><div class="sw" id="sw1"></div></div>
    <div><span class="pl">خامة الرخامة</span><div class="chips" id="ch1"></div></div>
    <div><span class="pl">نوع المقبض</span><div class="chips" id="ch2"></div></div>
    <div><label for="wd">طول المطبخ: <b id="wv"></b> متر</label><input id="wd" type="range" min="2" max="6" step="0.5" value="3.5"></div>
    <div><span class="pl">التقسيم</span><div class="chips" id="ch3"></div></div>
    <div><span class="pl">ملحقات</span><div class="chips" id="ch4"></div></div>
    <p class="sum" id="sum"></p>
    <a class="btn" id="send" href="#contact">ابعت التصميم لفريقنا</a>
   </div>
  </div>
 </div>
</section>

<!-- 10. قسم تواصل معنا والطلب -->
<section class="contact" id="contact">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('contact')">🎨 خلفية التواصل</button>
 <div class="w">
  <h2 id="contactTitle" data-k="contact_section.title" contenteditable="true">اطلب عرض سعر</h2>
  <form id="fm">
   <input type="text" id="nm" placeholder="الاسم" required aria-label="الاسم">
   <input type="tel" id="ph2" placeholder="رقم الموبايل" required aria-label="رقم الموبايل">
   <select id="ty" aria-label="نوع الطلب"></select>
   <textarea id="ms" rows="4" placeholder="تفاصيل إضافية (المساحة، المنطقة…)" aria-label="تفاصيل"></textarea>
   <button class="btn d" type="submit" id="contactSubmitBtn" data-k="contact_section.submit" contenteditable="true">ابعت على واتساب</button>
  </form>
 </div>
</section>

<!-- 11. الفوتر -->
<footer id="mainFooter">
 <button type="button" class="kyn-sec-styler-btn" onclick="openSecStyler('mainFooter')">🎨 خلفية الفوتر</button>
 <div class="w" id="footGrid"></div>
 <p class="cp" id="cp" data-k="footer.copyright" contenteditable="true"></p>
</footer>

<!-- 12. زر الواتساب العائم -->
<a class="fab" id="fab" href="#" aria-label="واتساب"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.7 1.1 1.5 1.9 2.7 2.5.3.2.5.1.7-.1l.8-1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.4.1.2.1.8-.1 1.4z"/></svg></a>

<!-- ==================== نوافذ المودال التفاعلية ==================== -->

<!-- نافذة إدارة واختيار وإضافة الخطوط -->
<div class="kyn-modal" id="fontManagerModal">
 <div class="kyn-modal-box" style="max-width:640px">
  <div class="kyn-modal-header">
   <h3>🔤 خطوط الموقع وإضافة خط جديد</h3>
   <button class="kyn-modal-close" onclick="closeModal('fontManagerModal')">&times;</button>
  </div>

  <!-- 1. تعيين الخط الأساسي للكل -->
  <div style="background:rgba(255,255,255,0.03);padding:14px 16px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);margin-bottom:18px">
   <label style="font-weight:700;font-size:13px;display:block;margin-bottom:8px;color:#F4F1E8">الخط الأساسي للموقع بالكامل (Global Site Font):</label>
   <div style="display:flex;gap:10px;align-items:center">
    <select id="globalSiteFontSelect" style="flex:1;padding:9px 12px;border:1px solid rgba(255,255,255,0.2);border-radius:6px;font-size:14px;background:#0F2B4C;color:#F4F1E8;outline:none">
    </select>
    <button type="button" class="btn" onclick="applyGlobalSiteFont()">تطبيق على كل الموقع</button>
   </div>
   <div style="font-size:12px;color:#9FB3CC;margin-top:6px">سيتم تغيير الخط الافتراضي لكامل نصوص الموقع فوراً.</div>
  </div>

  <!-- 2. إضافة خط جديد -->
  <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:16px">
   <h4 style="font-size:15px;margin-bottom:12px;color:var(--gold)">➕ إضافة خط جديد من عندك:</h4>
   
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
    <!-- خيار Google Fonts -->
    <div style="border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:14px;background:rgba(255,255,255,0.03)">
     <div style="font-weight:700;font-size:13px;margin-bottom:4px;color:#F4F1E8">1. إضافة من Google Fonts</div>
     <p style="font-size:11px;color:#9FB3CC;margin-bottom:10px">اكتب اسم أي خط من مكتبة Google</p>
     <input type="text" id="googleFontInput" placeholder="مثال: Rubik أو El Messiri" style="width:100%;padding:8px 10px;border:1px solid rgba(255,255,255,0.2);border-radius:6px;font-size:13px;margin-bottom:10px;background:#0F2B4C;color:#F4F1E8">
     <button type="button" class="btn" style="width:100%;padding:8px;font-size:12px" onclick="addNewGoogleFont()">+ إضافة الخط للقائمة</button>
    </div>

    <!-- خيار رفع ملف خط -->
    <div style="border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:14px;background:rgba(255,255,255,0.03)">
     <div style="font-weight:700;font-size:13px;margin-bottom:4px;color:#F4F1E8">2. رفع ملف خط من جهازك</div>
     <p style="font-size:11px;color:#9FB3CC;margin-bottom:10px">ملفات (.woff2, .woff, .ttf, .otf)</p>
     <input type="text" id="customFontNameInput" placeholder="اسم الخط (مثال: MyBrand)" style="width:100%;padding:8px 10px;border:1px solid rgba(255,255,255,0.2);border-radius:6px;font-size:13px;margin-bottom:10px;background:#0F2B4C;color:#F4F1E8">
     <label class="btn o" style="display:block;text-align:center;color:#F4F1E8;border-color:rgba(255,255,255,0.25);padding:7px;font-size:12px;cursor:pointer;margin-bottom:8px">
      📁 اختيار ملف الخط
      <input type="file" id="fontFileInput" accept=".woff2,.woff,.ttf,.otf" style="display:none" onchange="handleFontFileSelected(this.files[0])">
     </label>
     <div id="fontUploadStatus" style="font-size:11px;color:var(--gold);margin-bottom:6px"></div>
     <button type="button" class="btn" style="width:100%;padding:8px;font-size:12px" onclick="uploadCustomFontFile()">رفع وتثبيت الخط</button>
    </div>
   </div>
  </div>

  <!-- 3. معرض ومعاينة الخطوط المتوفرة -->
  <div style="margin-top:20px;border-top:1px solid rgba(255,255,255,0.1);padding-top:16px">
   <h4 style="font-size:15px;margin-bottom:10px;color:var(--gold)">معاينة الخطوط المتاحة حالياً:</h4>
   <div id="fontsShowcaseList" style="display:grid;gap:8px;max-height:220px;overflow-y:auto;padding-right:4px">
   </div>
  </div>
 </div>
</div>

  <!-- 3. معرض ومعاينة الخطوط المتوفرة -->
  <div style="margin-top:20px;border-top:1px solid var(--line);padding-top:16px">
   <h4 style="font-size:15px;margin-bottom:10px;color:var(--navy)">معاينة الخطوط المتاحة حالياً:</h4>
   <div id="fontsShowcaseList" style="display:grid;gap:8px;max-height:220px;overflow-y:auto;padding-right:4px">
   </div>
  </div>
 </div>
</div>

<!-- نافذة تنسيق خلفية الكونتينر / الأقسام -->
<div class="kyn-modal" id="secStylerModal">
 <div class="kyn-modal-box">
  <div class="kyn-modal-header">
   <h3>🎨 تنسيق خلفية ولون القسم</h3>
   <button class="kyn-modal-close" onclick="closeModal('secStylerModal')">&times;</button>
  </div>
  <div>
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:8px;color:#F4F1E8">1. اختر لون الخلفية للكونتينر:</label>
   <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px">
    <button type="button" class="btn" style="background:#FFFFFF;color:#0A1E36;border:1px solid #ccc;padding:6px 14px;font-size:12px" onclick="setSecBg('#FFFFFF')">⚪ أبيض ناصع</button>
    <button type="button" class="btn" style="background:#F4F1EA;color:#0A1E36;border:1px solid #dcd4c4;padding:6px 14px;font-size:12px" onclick="setSecBg('#F4F1EA')">🟤 بيج ناعم (الافتراضي)</button>
    <button type="button" class="btn" style="background:#0A1E36;color:#F4F1E8;border:1px solid rgba(245,184,0,.4);padding:6px 14px;font-size:12px" onclick="setSecBg('#0A1E36')">🔵 كحلي كينشب</button>
    <button type="button" class="btn" style="background:#081628;color:#F4F1E8;border:1px solid #000;padding:6px 14px;font-size:12px" onclick="setSecBg('#081628')">🌌 كحلي داكن ملكي</button>
    <button type="button" class="btn" style="background:#FFF8E7;color:#0A1E36;border:1px solid #F5B800;padding:6px 14px;font-size:12px" onclick="setSecBg('#FFF8E7')">🟡 ذهبي خفيف</button>
    <button type="button" class="btn" style="background:#12335a;color:#F4F1E8;border:1px solid #0F2B4C;padding:6px 14px;font-size:12px" onclick="setSecBg('#12335a')">🔘 رمادي داكن فخم</button>
   </div>
   <div style="display:flex;align-items:center;gap:10px;margin-top:10px">
    <label style="font-weight:600;font-size:12px;color:#9FB3CC">أو اختر أي لون حر:</label>
    <input type="color" id="secCustomColorPicker" style="width:34px;height:34px;border:1px solid rgba(255,255,255,.3);border-radius:4px;cursor:pointer;background:none" onchange="setSecBg(this.value)">
   </div>
  </div>
  <hr style="border:0;border-top:1px solid rgba(255,255,255,0.1);margin:18px 0">
  <div>
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:8px;color:#F4F1E8">2. نمط لون نصوص القسم:</label>
   <div style="display:flex;gap:10px">
    <button type="button" class="btn" style="background:#0A1E36;color:#F4F1E8;border:1px solid rgba(255,255,255,.2);padding:6px 14px;font-size:12px" onclick="setSecTextColor('#0A1E36')">☀️ نصوص داكنة (للخلفيات الفاتحة)</button>
    <button type="button" class="btn" style="background:rgba(255,255,255,0.1);color:#F4F1E8;border:1px solid var(--gold);padding:6px 14px;font-size:12px" onclick="setSecTextColor('#F4F1E8')">🌙 نصوص فاتحة (للخلفيات الداكنة)</button>
   </div>
  </div>
  <hr style="border:0;border-top:1px solid rgba(255,255,255,0.1);margin:18px 0">
  <div style="display:flex;justify-content:space-between;align-items:center">
   <button type="button" class="btn o" style="color:#ff6b6b;border-color:rgba(255,107,107,0.4);padding:6px 14px;font-size:12px" onclick="resetCurrentSecStyle()">استعادة الافتراضي</button>
   <button type="button" class="btn" style="padding:6px 20px;font-size:13px" onclick="closeModal('secStylerModal')">تم ✓</button>
  </div>
 </div>
</div>

<!-- نافذة اختيار وتغيير وتنسيق الصور -->
<div class="kyn-modal" id="imageModal">
 <div class="kyn-modal-box" style="max-width:680px">
  <div class="kyn-modal-header">
   <h3>📷 تعديل وتنسيق الصورة ومقاساتها</h3>
   <button class="kyn-modal-close" onclick="closeModal('imageModal')">&times;</button>
  </div>

  <!-- 1. صندوق الإرشادات والمقاسات الموصى بها بتنسيق ذهبي كحلي فخم -->
  <div id="modalImgSpecBox" style="background:rgba(245,184,0,0.07);border:1px solid rgba(245,184,0,0.35);border-radius:10px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;gap:14px">
   <div>
    <div style="font-weight:800;color:#F4F1E8;font-size:14px;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
     <span style="color:var(--gold)">📐 المقاس الموصى به لهذه الحاوية:</span>
     <span id="modalImgSpecDim" style="color:#0A1E36;background:var(--gold);font-size:14px;font-weight:900;direction:ltr;padding:3px 12px;border-radius:16px">600 × 800 px</span>
    </div>
    <div id="modalImgSpecNote" style="font-size:12px;color:#9FB3CC;margin-top:4px">كارت رأسي للأقسام — النسبة الطولية 3:4 تبرز تصميم وتفاصيل الدواليب والمطابخ</div>
   </div>
   <div id="modalImgSpecRatio" style="font-size:12px;background:rgba(255,255,255,0.06);color:var(--gold);border:1px solid rgba(245,184,0,0.4);padding:5px 12px;border-radius:16px;font-weight:700;white-space:nowrap">3:4 عمودية (طولية)</div>
  </div>

  <!-- 2. شاشة معاينة حية لشكل الصورة في الكونتينر -->
  <div style="margin-bottom:16px;border:1px solid rgba(255,255,255,0.15);border-radius:10px;overflow:hidden;background:#050F1D;position:relative;box-shadow:inset 0 2px 10px rgba(0,0,0,0.5)">
   <div style="position:absolute;top:8px;left:8px;z-index:2;background:rgba(8,20,38,0.85);backdrop-filter:blur(6px);color:var(--gold);border:1px solid rgba(245,184,0,0.3);font-size:11px;font-weight:600;padding:2px 10px;border-radius:12px">معاينة حية لشكل الصورة داخل الكونتينر</div>
   <div id="modalImgPreviewBox" style="height:170px;background-size:cover;background-position:center;background-repeat:no-repeat;transition:all .25s"></div>
  </div>

  <!-- 3. حل مشكلة الصورة ما تتكلش (Image Fit & Alignment) بتصميم متناسق تماماً -->
  <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:14px;margin-bottom:18px">
   <label style="display:block;font-weight:800;font-size:13px;margin-bottom:10px;color:#F4F1E8">
    🖼️ طريقة عرض واحتواء الصورة في الكونتينر:
   </label>
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
    <label id="lblFitCover" class="kyn-fit-card" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;padding:12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1.5px solid rgba(255,255,255,0.12);transition:all .2s">
     <input type="radio" name="imgFitChoice" value="cover" id="fitCover" checked onchange="updateImgFitSettings()" style="accent-color:var(--gold);margin-top:3px">
     <div>
      <div style="font-weight:800;color:#F4F1E8;font-size:13px">ملء الإطار (Cover)</div>
      <div style="font-size:11px;color:#9FB3CC;margin-top:2px">تغطي كامل مساحة الكونتينر بدون فراغات (مظهر فخم)</div>
     </div>
    </label>
    <label id="lblFitContain" class="kyn-fit-card" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;padding:12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1.5px solid rgba(255,255,255,0.12);transition:all .2s">
     <input type="radio" name="imgFitChoice" value="contain" id="fitContain" onchange="updateImgFitSettings()" style="accent-color:var(--gold);margin-top:3px">
     <div>
      <div style="font-weight:800;color:var(--gold);font-size:13px">احتواء كامل (Contain) ⭐ ما تتكلش</div>
      <div style="font-size:11px;color:#9FB3CC;margin-top:2px">تظهر الصورة كاملة 100% بكامل تفاصيلها بدون أي قص</div>
     </div>
    </label>
   </div>
   <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px;flex-wrap:wrap;padding-top:10px;border-top:1px solid rgba(255,255,255,0.08)">
    <div style="display:flex;align-items:center;gap:8px">
     <span style="font-weight:700;color:#F4F1E8">نقطة التركيز:</span>
     <select id="imgPosSelect" style="padding:6px 12px;border-radius:6px;border:1px solid rgba(255,255,255,0.2);font-size:12px;background:#0F2B4C;color:#F4F1E8;cursor:pointer;outline:none" onchange="updateImgFitSettings()">
      <option value="center">في المنتصف (Center)</option>
      <option value="top">التركيز على أعلى الصورة (Top)</option>
      <option value="bottom">التركيز على أسفل الصورة (Bottom)</option>
     </select>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
     <span style="font-weight:700;color:#F4F1E8">لون خلفية الكونتينر (في حال الاحتواء):</span>
     <input type="color" id="imgBgColorSelect" value="#0A1E36" style="width:30px;height:30px;border:1px solid rgba(255,255,255,0.3);border-radius:6px;cursor:pointer;background:none" onchange="updateImgFitSettings()">
    </div>
   </div>
  </div>

  <!-- 4. خيارات رفع أو اختيار الصورة -->
  <div style="margin-bottom:16px">
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:8px;color:#F4F1E8">1. رفع صورة جديدة من جهازك:</label>
   <label class="btn" style="display:inline-flex;align-items:center;gap:8px;font-size:13px;padding:9px 22px;cursor:pointer;background:var(--gold);color:#0A1E36;font-weight:800;border-radius:24px">
    ⬆️ اختيار صورة من جهازك
    <input type="file" id="modalFileInput" accept="image/*" style="display:none" onchange="handleModalUpload(this.files[0])">
   </label>
   <div id="uploadStatus" style="font-size:12px;color:var(--gold);margin-top:6px;font-weight:600"></div>
  </div>
  <hr style="border:0;border-top:1px solid rgba(255,255,255,0.1);margin:16px 0">
  <div style="margin-bottom:16px">
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:8px;color:#F4F1E8">2. أو اختر من مكتبة صور الموقع المتوفرة:</label>
   <div class="kyn-gallery-grid" id="modalGalleryGrid"></div>
  </div>
  <hr style="border:0;border-top:1px solid rgba(255,255,255,0.1);margin:16px 0">
  <div>
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:8px;color:#F4F1E8">3. أو أدخل مسار الصورة مباشرة:</label>
   <div style="display:flex;gap:8px">
    <input type="text" id="modalCustomUrl" placeholder="images/example.jpg" style="flex:1;padding:9px 14px;border:1px solid rgba(255,255,255,0.2);border-radius:6px;font-size:13px;background:#0F2B4C;color:#F4F1E8">
    <button type="button" class="btn o" style="padding:8px 20px;font-size:13px;color:#F4F1E8;border-color:rgba(255,255,255,0.3)" onclick="applyCustomImageUrl()">تطبيق</button>
   </div>
  </div>
 </div>
</div>

  <!-- 4. خيارات رفع أو اختيار الصورة -->
  <div>
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:6px">1. رفع صورة جديدة من جهازك:</label>
   <label class="btn" style="display:inline-flex;align-items:center;gap:8px;font-size:13px;padding:8px 18px;cursor:pointer">
    ⬆️ اختر ملف صورة من جهازك
    <input type="file" id="modalFileInput" accept="image/*" style="display:none" onchange="handleModalUpload(this.files[0])">
   </label>
   <div id="uploadStatus" style="font-size:12px;color:var(--mute);margin-top:6px"></div>
  </div>
  <hr style="border:0;border-top:1px solid var(--line);margin:16px 0">
  <div>
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:8px">2. أو اختر من مكتبة صور الموقع المتوفرة:</label>
   <div class="kyn-gallery-grid" id="modalGalleryGrid"></div>
  </div>
  <hr style="border:0;border-top:1px solid var(--line);margin:16px 0">
  <div>
   <label style="display:block;font-weight:700;font-size:13px;margin-bottom:6px">3. أو أدخل مسار الصورة مباشرة:</label>
   <div style="display:flex;gap:8px">
    <input type="text" id="modalCustomUrl" placeholder="images/example.jpg" style="flex:1;padding:8px 12px;border:1px solid var(--line);border-radius:4px;font-size:13px">
    <button type="button" class="btn" style="padding:8px 16px;font-size:13px" onclick="applyCustomImageUrl()">تطبيق</button>
   </div>
  </div>
 </div>
</div>
</div>

<!-- نافذة ربط الموقع بـ GitHub و Netlify للنشر التلقائي -->
<div class="kyn-modal" id="githubModal">
 <div class="kyn-modal-box" style="max-width:580px">
  <div class="kyn-modal-header">
   <h3>🐙 ربط الموقع مع GitHub و Netlify</h3>
   <button class="kyn-modal-close" onclick="closeModal('githubModal')">&times;</button>
  </div>

  <div style="background:rgba(245,184,0,0.07);border:1px solid rgba(245,184,0,0.3);border-radius:8px;padding:12px 14px;margin-bottom:16px">
   <div style="font-weight:700;color:var(--gold);font-size:13px;margin-bottom:4px">🚀 النشر التلقائي المباشر (مجاني 100% مدى الحياة):</div>
   <div style="font-size:12px;color:#9FB3CC;line-height:1.6">
    بمجرد إدخال بيانات مستودع GitHub ورمز الوصول، سيقوم زر «حفظ ونشر التعديلات» بحفظ أي تعديل في GitHub وتحديث موقعك على Netlify تلقائياً خلال ثوانٍ!
   </div>
  </div>

  <form id="githubForm" onsubmit="saveGitHubSettings(event)" style="display:grid;gap:14px">
   <div>
    <label style="font-size:12px;font-weight:700;display:block;margin-bottom:6px;color:#F4F1E8">
     اسم المستودع على GitHub (Owner/Repository):
    </label>
    <input type="text" id="gh_repo" placeholder="مثال: username/kynship" required style="width:100%;padding:10px 12px;border:1px solid rgba(255,255,255,0.2);border-radius:6px;background:#0F2B4C;color:#F4F1E8;direction:ltr;text-align:left">
   </div>

   <div>
    <label style="font-size:12px;font-weight:700;display:block;margin-bottom:6px;color:#F4F1E8">
     اسم الفرع (Branch):
    </label>
    <input type="text" id="gh_branch" value="main" required style="width:100%;padding:10px 12px;border:1px solid rgba(255,255,255,0.2);border-radius:6px;background:#0F2B4C;color:#F4F1E8;direction:ltr;text-align:left">
   </div>

   <div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
     <label style="font-size:12px;font-weight:700;color:#F4F1E8">رمز الوصول الشخصي (GitHub Personal Access Token):</label>
     <a href="https://github.com/settings/tokens/new?scopes=repo&description=Kynship+CMS" target="_blank" rel="noopener" style="font-size:11px;color:var(--gold);text-decoration:underline">إنشاء رمز مجاناً ↗</a>
    </div>
    <div style="position:relative">
     <input type="password" id="gh_token" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" required style="width:100%;padding:10px 42px 10px 12px;border:1px solid rgba(255,255,255,0.2);border-radius:6px;background:#0F2B4C;color:#F4F1E8;direction:ltr;text-align:left">
     <button type="button" onclick="toggleTokenVisibility()" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);background:none;border:0;color:#9FB3CC;cursor:pointer;font-size:14px" title="إظهار / إخفاء">👁️</button>
    </div>
    <div style="font-size:11px;color:#9FB3CC;margin-top:4px">
     يتم حفظ الرمز بأمان محلياً في متصفحك فقط ولا يُشارك مع أي طرف ثالث.
    </div>
   </div>

   <div id="ghTestStatus" style="font-size:12px;font-weight:700;display:none;padding:8px 12px;border-radius:6px"></div>

   <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px">
    <button type="button" class="btn o" onclick="testGitHubConnection()" style="font-size:12px;padding:8px 16px;color:var(--gold);border-color:var(--gold)">
     🧪 فحص الاتصال بـ GitHub
    </button>
    <div style="display:flex;gap:8px">
     <button type="button" class="btn o" style="color:#F4F1E8;border-color:rgba(255,255,255,0.3);padding:8px 16px;font-size:12px" onclick="closeModal('githubModal')">إلغاء</button>
     <button type="submit" class="btn" style="padding:8px 20px;font-size:12px">حفظ الإعدادات ✓</button>
    </div>
   </div>
  </form>
 </div>
</div>

<!-- نافذة تعديل بيانات التواصل والروابط السريعة -->
<div class="kyn-modal" id="settingsModal">
 <div class="kyn-modal-box">
  <div class="kyn-modal-header">
   <h3>⚙️ بيانات التواصل وروابط السوشيال</h3>
   <button class="kyn-modal-close" onclick="closeModal('settingsModal')">&times;</button>
  </div>
  <form id="settingsForm" onsubmit="saveSettingsModal(event)" style="display:grid;gap:12px">
   <div>
    <label style="font-size:12px;font-weight:700;display:block;margin-bottom:4px">رقم واتساب (بدون + أو مسافات، مثال: 201010104140):</label>
    <input type="tel" id="set_wa" required style="width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:4px">
   </div>
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
    <div>
     <label style="font-size:12px;font-weight:700;display:block;margin-bottom:4px">Instagram:</label>
     <input type="url" id="set_ig" style="width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:4px">
    </div>
    <div>
     <label style="font-size:12px;font-weight:700;display:block;margin-bottom:4px">TikTok:</label>
     <input type="url" id="set_tt" style="width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:4px">
    </div>
    <div>
     <label style="font-size:12px;font-weight:700;display:block;margin-bottom:4px">Facebook:</label>
     <input type="url" id="set_fb" style="width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:4px">
    </div>
    <div>
     <label style="font-size:12px;font-weight:700;display:block;margin-bottom:4px">X (تويتر):</label>
     <input type="url" id="set_x" style="width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:4px">
    </div>
    <div>
     <label style="font-size:12px;font-weight:700;display:block;margin-bottom:4px">Threads:</label>
     <input type="url" id="set_th" style="width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:4px">
    </div>
    <div>
     <label style="font-size:12px;font-weight:700;display:block;margin-bottom:4px">Pinterest:</label>
     <input type="url" id="set_pin" style="width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:4px">
    </div>
   </div>
   <div style="margin-top:10px;display:flex;justify-content:flex-end;gap:8px">
    <button type="button" class="btn o" style="color:var(--ink);border-color:var(--line)" onclick="closeModal('settingsModal')">إلغاء</button>
    <button type="submit" class="btn">حفظ الإعدادات</button>
   </div>
  </form>
 </div>
</div>

<!-- نافذة تسجيل الدخول -->
<div id="kynLoginOverlay" style="display:none">
 <div class="kyn-login-card">
  <div class="kyn-login-logo">KYNSHIP</div>
  <h2>لوحة التعديل المباشر</h2>
  <p>أدخل كلمة المرور لتفعيل وضع التعديل الفوري على الموقع</p>
  <form onsubmit="handleLogin(event)">
   <input type="password" id="adminPasswordInput" placeholder="كلمة المرور" required autofocus autocomplete="current-password">
   <button type="submit" class="btn" style="width:100%">دخول لوحة التحكم</button>
   <div id="loginErrorMsg" style="color:#d32f2f;font-size:12px;margin-top:10px;font-weight:700"></div>
  </form>
 </div>
</div>

<div id="kynToast"></div>

<!-- ==================== البرمجية والمحرك ==================== -->
<script>
let C = {};
let dirty = false;
let isEditMode = true;
let currentEditingImgKey = null;
let currentFocusedElement = null;
let currentSelectedSecId = null;
let selectedFontFileToUpload = null;

const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

const IMGS = [
 'banner-main', 'banner-2', 'cat-kitchen', 'cat-wardrobes',
 'cat-aluminium', 'cat-3d', 'proj-shorouk', 'proj-wood'
];

/* قائمة الخطوط الافتراضية الجاهزة */
const DEFAULT_FONTS = [
 { name: 'Cairo', label: 'Cairo (كيرو - الافتراضي)', type: 'google' },
 { name: 'Tajawal', label: 'Tajawal (تجوال)', type: 'google' },
 { name: 'Almarai', label: 'Almarai (المراعي)', type: 'google' },
 { name: 'Alexandria', label: 'Alexandria (الإسكندرية)', type: 'google' },
 { name: 'Readex Pro', label: 'Readex Pro (ريدكس برو)', type: 'google' },
 { name: 'Noto Kufi Arabic', label: 'Noto Kufi (كوفي حديث)', type: 'google' },
 { name: 'Amiri', label: 'Amiri (أميري كلاسيك)', type: 'google' },
 { name: 'Changa', label: 'Changa (تشانجا هندسي)', type: 'google' },
 { name: 'Outfit', label: 'Outfit (أوتفيت فاخر)', type: 'google' },
 { name: 'Playfair Display', label: 'Playfair (بلايفير سيريف)', type: 'google' },
 { name: 'Inter', label: 'Inter (إنتر عصري)', type: 'google' }
];

/* ===== التنبيهات Toast ===== */
function toast(msg, ms = 3000) {
 const t = $('kynToast');
 t.textContent = msg;
 t.style.display = 'flex';
 clearTimeout(toast.timer);
 toast.timer = setTimeout(() => { t.style.display = 'none'; }, ms);
}

/* ===== إدارة حالة الحفظ Dirty Flag ===== */
function markDirty() {
 dirty = true;
 $('btnSaveAdmin').disabled = false;
 $('btnSaveAdmin').textContent = '💾 حفظ ونشر التعديلات ●';
 const ind = $('kynDirtyIndicator');
 ind.textContent = 'تعديلات غير محفوظة ●';
 ind.className = 'kyn-dirty-pill has-changes';
}

function clearDirty() {
 dirty = false;
 $('btnSaveAdmin').disabled = true;
 $('btnSaveAdmin').textContent = '💾 حفظ ونشر التعديلات';
 const ind = $('kynDirtyIndicator');
 ind.textContent = 'كل التعديلات محفوظة ✓';
 ind.className = 'kyn-dirty-pill';
}

/* ===== الأمان وتسجيل الدخول ===== */
const PASS = 'DJ!16GfZSZEQdKS$RGJL';
function isLogged() {
 return sessionStorage.getItem('kyn_admin') === '1';
}

function handleLogin(e) {
 e.preventDefault();
 const p = $('adminPasswordInput').value.trim();
 if (p === PASS) {
  sessionStorage.setItem('kyn_admin', '1');
  $('kynLoginOverlay').style.display = 'none';
  toast('مرحباً بك! وضع التعديل المباشر مفعل الآن ✏️');
 } else {
  $('loginErrorMsg').textContent = 'كلمة المرور غير صحيحة، حاول مجدداً';
  $('adminPasswordInput').value = '';
 }
}

$('btnLogoutAdmin').onclick = () => {
 sessionStorage.removeItem('kyn_admin');
 location.reload();
};

/* ===== تبديل وضع التعديل / معاينة الزائر ===== */
$('btnToggleMode').onclick = () => {
 isEditMode = !isEditMode;
 if (isEditMode) {
  document.body.classList.add('kyn-edit-mode');
  $('btnToggleMode').classList.add('active');
  $('modeIcon').textContent = '✏️';
  $('modeText').textContent = 'وضع التعديل';
  toast('وضع التعديل مفعّل — اضغط على أي نص أو صورة للتعديل والتنسيق');
  enableContentEditable(true);
 } else {
  document.body.classList.remove('kyn-edit-mode');
  $('btnToggleMode').classList.remove('active');
  $('modeIcon').textContent = '👁️';
  $('modeText').textContent = 'معاينة كزائر';
  hideTextFormatBar();
  toast('معاينة كزائر — تم إخفاء أدوات التعديل');
  enableContentEditable(false);
 }
};

function enableContentEditable(enabled) {
 document.querySelectorAll('[data-k]').forEach(el => {
  el.contentEditable = enabled ? 'true' : 'false';
 });
}

/* ===== قراءة وتعديل البيانات المتداخلة ===== */
function getVal(path) {
 return path.split('.').reduce((acc, part) => acc?.[part], C);
}

function setVal(path, val) {
 const parts = path.split('.');
 let obj = C;
 for (let i = 0; i < parts.length - 1; i++) {
  if (!obj[parts[i]]) obj[parts[i]] = {};
  obj = obj[parts[i]];
 }
 obj[parts[parts.length - 1]] = val;
 markDirty();
}

/* ===== محرك إدارة الخطوط والخطوط المخصصة ===== */
function getAllAvailableFonts() {
 const customs = Array.isArray(C.customFonts) ? C.customFonts : [];
 return [...DEFAULT_FONTS, ...customs];
}

function loadCustomFonts(customFonts) {
 if (!Array.isArray(customFonts)) return;
 customFonts.forEach(f => {
  if (f.type === 'google' && f.name) {
   const id = 'gf_' + f.name.replace(/\s+/g, '_');
   if (!document.getElementById(id)) {
    const link = document.createElement('link');
    link.id = id; link.rel = 'stylesheet';
    link.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(f.name) + ':wght@300;400;600;700;900&display=swap';
    document.head.appendChild(link);
   }
  } else if (f.type === 'file' && f.name && f.url) {
   const id = 'ff_' + f.name.replace(/\s+/g, '_');
   if (!document.getElementById(id)) {
    const st = document.createElement('style');
    st.id = id;
    st.textContent = "@font-face { font-family: '" + f.name + "'; src: url('" + f.url + "'); font-display: swap; }";
    document.head.appendChild(st);
   }
  }
 });
}

function populateFontDropdowns() {
 const fonts = getAllAvailableFonts();

 const textSel = $('textFontSelect');
 if (textSel) {
  let h = '<option value="">نوع الخط...</option>';
  fonts.forEach(f => {
   h += `<option value="${f.name}" style="font-family:'${f.name}',sans-serif">${esc(f.label || f.name)}</option>`;
  });
  h += '<option value="__ADD_NEW__">➕ أضف خطاً جديداً...</option>';
  textSel.innerHTML = h;
 }

 const globalSel = $('globalSiteFontSelect');
 if (globalSel) {
  let h = '';
  fonts.forEach(f => {
   const isSel = (C.globalFont === f.name);
   h += `<option value="${f.name}" ${isSel?'selected':''} style="font-family:'${f.name}',sans-serif">${esc(f.label || f.name)}</option>`;
  });
  globalSel.innerHTML = h;
 }

 const showcase = $('fontsShowcaseList');
 if (showcase) {
  showcase.innerHTML = fonts.map(f => `
   <div style="background:#fff;border:1px solid var(--line);border-radius:6px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px">
    <div style="min-width:0;flex:1">
     <div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:2px">${esc(f.label || f.name)} <span style="font-size:10px;color:var(--mute)">(${f.type === 'file'?'ملف مخصص':'Google Font'})</span></div>
     <div style="font-family:'${f.name}',sans-serif;font-size:15px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
      كينشب للمطابخ والدواليب · Kynship Luxury Kitchens
     </div>
    </div>
    <button type="button" class="btn o" style="font-size:11px;padding:4px 10px;white-space:nowrap" onclick="applyGlobalSiteFont('${f.name}')">تعيين للموقع</button>
   </div>
  `).join('');
 }
}

function handleFontSelectChange(val) {
 if (val === '__ADD_NEW__') {
  $('textFontSelect').value = '';
  openModal('fontManagerModal');
 } else if (val) {
  applyTextFont(val);
 }
}

function applyTextFont(fontName) {
 if (!currentFocusedElement) return;
 const el = currentFocusedElement;
 el.style.fontFamily = "'" + fontName + "', Cairo, sans-serif";

 const k = getStyleKey(el);
 if (k) {
  C.styles = C.styles || {};
  C.styles[k] = C.styles[k] || {};
  C.styles[k].fontFamily = fontName;
  markDirty();
 }
 toast('تم تطبيق خط ' + fontName + ' على هذا النص ✓');
}

function applyGlobalSiteFont(fontName) {
 const chosen = fontName || $('globalSiteFontSelect').value;
 if (!chosen) return;
 C.globalFont = chosen;
 document.body.style.fontFamily = "'" + chosen + "', Cairo, Tahoma, sans-serif";
 markDirty();
 populateFontDropdowns();
 closeModal('fontManagerModal');
 toast('تم تعيين خط "' + chosen + '" كخط أساسي للموقع بالكامل ✓');
}

function addNewGoogleFont() {
 const name = $('googleFontInput').value.trim();
 if (!name) return alert('برجاء كتابة اسم الخط أولاً');

 const id = 'gf_' + name.replace(/\s+/g, '_');
 const link = document.createElement('link');
 link.id = id; link.rel = 'stylesheet';
 link.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(name) + ':wght@300;400;600;700;900&display=swap';
 document.head.appendChild(link);

 C.customFonts = C.customFonts || [];
 if (!C.customFonts.find(f => f.name.toLowerCase() === name.toLowerCase())) {
  C.customFonts.push({ name: name, label: name + ' (Google Font)', type: 'google' });
  markDirty();
 }
 $('googleFontInput').value = '';
 populateFontDropdowns();
 toast('تمت إضافة خط "' + name + '" بنجاح ويمكنك استخدامه الآن! ✓');
}

function handleFontFileSelected(file) {
 if (!file) return;
 selectedFontFileToUpload = file;
 $('fontUploadStatus').textContent = 'الملف المختار: ' + file.name;
 if (!$('customFontNameInput').value) {
  const base = file.name.replace(/\.[^/.]+$/, '').replace(/[^a-zA-Z0-9]/g, '');
  $('customFontNameInput').value = base;
 }
}

function uploadCustomFontFile() {
 const file = selectedFontFileToUpload;
 const fontName = $('customFontNameInput').value.trim();
 if (!file || !fontName) return alert('برجاء اختيار ملف الخط وتحديد اسمه');

 $('fontUploadStatus').textContent = 'جاري رفع وتثبيت الخط…';
 const rd = new FileReader();
 rd.onload = () => {
  const bytes = new Uint8Array(rd.result);
  const ext = file.name.split('.').pop();
  const safeName = fontName.replace(/[^a-zA-Z0-9_-]/g, '_') + '.' + ext;

  fetch('upload.php', {
   method: 'POST',
   headers: {
    'X-Mode': 'font',
    'X-Img-Name': safeName
   },
   body: bytes
  })
  .then(r => r.json())
  .then(data => {
   const fontUrl = data.url || ('fonts/' + safeName);
   registerFontInDOM(fontName, fontUrl);
  })
  .catch(() => {
   const blob = new Blob([bytes]);
   const blobUrl = URL.createObjectURL(blob);
   registerFontInDOM(fontName, blobUrl);
  });
 };
 rd.readAsArrayBuffer(file);
}

function registerFontInDOM(fontName, fontUrl) {
 const st = document.createElement('style');
 st.textContent = "@font-face { font-family: '" + fontName + "'; src: url('" + fontUrl + "'); font-display: swap; }";
 document.head.appendChild(st);

 C.customFonts = C.customFonts || [];
 C.customFonts.push({ name: fontName, label: fontName + ' (ملف مخصص)', type: 'file', url: fontUrl });
 markDirty();

 selectedFontFileToUpload = null;
 $('fontFileInput').value = '';
 $('customFontNameInput').value = '';
 $('fontUploadStatus').textContent = 'تم تثبيت الخط بنجاح ✓';
 populateFontDropdowns();
 toast('تم تثبيت خط "' + fontName + '" وأصبح جاهزاً للاستخدام ✓');
}

/* ===== شريط تنسيق النصوص العائم ===== */
function showTextFormatBar(el) {
 if (!isEditMode) return;
 currentFocusedElement = el;
 const bar = $('kynTextFormatBar');
 const rect = el.getBoundingClientRect();
 
 const currentSize = parseInt(window.getComputedStyle(el).fontSize) || 16;
 $('currentFontSizeLbl').textContent = currentSize + 'px';
 
 bar.style.display = 'flex';
 const topPos = Math.max(60, rect.top - 46);
 const leftPos = Math.min(window.innerWidth - 220, Math.max(220, rect.left + rect.width / 2));
 bar.style.top = topPos + 'px';
 bar.style.left = leftPos + 'px';
}

function hideTextFormatBar() {
 $('kynTextFormatBar').style.display = 'none';
 currentFocusedElement = null;
}

function getStyleKey(el) {
 if (!el) return null;
 return el.getAttribute('data-k') || el.id || null;
}

function adjustFontSize(delta) {
 if (!currentFocusedElement) return;
 const el = currentFocusedElement;
 const curr = parseInt(window.getComputedStyle(el).fontSize) || 16;
 const next = Math.max(10, Math.min(120, curr + delta)) + 'px';
 el.style.fontSize = next;
 $('currentFontSizeLbl').textContent = next;
 
 const k = getStyleKey(el);
 if (k) {
  C.styles = C.styles || {};
  C.styles[k] = C.styles[k] || {};
  C.styles[k].fontSize = next;
  markDirty();
 }
}

function toggleFontWeight() {
 if (!currentFocusedElement) return;
 const el = currentFocusedElement;
 const curr = window.getComputedStyle(el).fontWeight;
 const next = (curr === 'bold' || parseInt(curr) >= 700) ? '400' : '900';
 el.style.fontWeight = next;
 
 const k = getStyleKey(el);
 if (k) {
  C.styles = C.styles || {};
  C.styles[k] = C.styles[k] || {};
  C.styles[k].fontWeight = next;
  markDirty();
 }
}

function applyTextColor(color) {
 if (!currentFocusedElement) return;
 const el = currentFocusedElement;
 el.style.color = color;
 
 const k = getStyleKey(el);
 if (k) {
  C.styles = C.styles || {};
  C.styles[k] = C.styles[k] || {};
  C.styles[k].color = color;
  markDirty();
 }
 toast('تم تغيير لون النص إلى ' + color);
}

function resetCurrentTextStyle() {
 if (!currentFocusedElement) return;
 const el = currentFocusedElement;
 el.style.color = '';
 el.style.fontSize = '';
 el.style.fontWeight = '';
 el.style.fontFamily = '';
 
 const k = getStyleKey(el);
 if (k && C.styles && C.styles[k]) {
  delete C.styles[k];
  markDirty();
 }
 toast('تمت استعادة التنسيق الافتراضي للنص');
 hideTextFormatBar();
}

/* ===== أداة تنسيق خلفيات الأقسام والكونتينرات ===== */
function openSecStyler(secId) {
 currentSelectedSecId = secId;
 openModal('secStylerModal');
}

function setSecBg(bg) {
 if (!currentSelectedSecId) return;
 const el = $(currentSelectedSecId);
 if (!el) return;
 el.style.background = bg;
 
 C.styles = C.styles || {};
 C.styles[currentSelectedSecId] = C.styles[currentSelectedSecId] || {};
 C.styles[currentSelectedSecId].bg = bg;
 markDirty();
 toast('تم تحديث خلفية الكونتينر ✓');
}

function setSecTextColor(color) {
 if (!currentSelectedSecId) return;
 const el = $(currentSelectedSecId);
 if (!el) return;
 el.style.color = color;
 
 C.styles = C.styles || {};
 C.styles[currentSelectedSecId] = C.styles[currentSelectedSecId] || {};
 C.styles[currentSelectedSecId].color = color;
 markDirty();
 toast('تم تحديث نمط نصوص الكونتينر ✓');
}

function resetCurrentSecStyle() {
 if (!currentSelectedSecId) return;
 const el = $(currentSelectedSecId);
 if (el) {
  el.style.background = '';
  el.style.color = '';
 }
 if (C.styles && C.styles[currentSelectedSecId]) {
  delete C.styles[currentSelectedSecId];
  markDirty();
 }
 closeModal('secStylerModal');
 toast('تمت استعادة الخلفية الافتراضية للقسم');
}

/* تطبيق جميع التنسيقات المخزنة في C.styles */
function applyAllStyles(styles) {
 if (!styles) return;
 Object.entries(styles).forEach(([k, st]) => {
  const el = $(k) || document.querySelector(`[data-k="${k}"]`) || document.querySelector(k);
  if (el) {
   if (st.color) el.style.color = st.color;
   if (st.bg) el.style.background = st.bg;
   if (st.fontSize) el.style.fontSize = st.fontSize;
   if (st.fontWeight) el.style.fontWeight = st.fontWeight;
   if (st.fontFamily) el.style.fontFamily = "'" + st.fontFamily + "', Cairo, sans-serif";
   if (st.textAlign) el.style.textAlign = st.textAlign;
  }
 });
}

/* ===== ربط وتفعيل التعديل المباشر للنصوص ===== */
function bindInlineTextEditing() {
 document.querySelectorAll('[data-k]').forEach(el => {
  el.contentEditable = isEditMode ? 'true' : 'false';
  
  el.onclick = e => {
   if (isEditMode) {
    if (el.tagName === 'A') e.preventDefault();
    showTextFormatBar(el);
   }
  };
  
  el.onfocus = () => {
   if (isEditMode) showTextFormatBar(el);
  };
  
  el.oninput = () => {
   const key = el.getAttribute('data-k');
   if (key) {
    if (key.includes('tagline_en')) {
     setVal(key, el.innerHTML);
    } else {
     setVal(key, el.textContent.trim());
    }
   }
  };
 });
}

document.addEventListener('click', e => {
 if (!e.target.closest('#kynTextFormatBar') && !e.target.closest('[data-k]')) {
  hideTextFormatBar();
 }
});

/* ===== إدارة النوافذ المنبثقة ===== */
function openModal(id) { $(id).classList.add('show'); }
function closeModal(id) { $(id).classList.remove('show'); }

window.onclick = e => {
 if (e.target.classList.contains('kyn-modal')) {
  e.target.classList.remove('show');
 }
};

/* ===== مواصفات المقاسات الدقيقة وطريقة الاحتواء لكل حاوية صورة ===== */
function getImageSpecs(key) {
 if (!key) return { dim: '800 × 600 px', ratio: '4:3', note: 'المقاس الموصى به للحاوية' };
 if (key === 'banner.img' || key === 'banner') {
  return {
   dim: '1920 × 650 px',
   ratio: '16:5 بانر عريض',
   note: 'بانر عريض Ultra-wide يمتد بكامل عرض الشاشة — مثالي لإظهار مطبخ كامل بزاوية واسعة'
  };
 }
 if (key === 'story.img' || key === 'story') {
  return {
   dim: '800 × 600 px',
   ratio: '4:3 أفقية كلاسيك',
   note: 'صورة بجانب قصة Kynship — النسبة 4:3 كلاسيكية أو 1200 × 900 px لجودة فائقة'
  };
 }
 if (key.startsWith('cats.')) {
  return {
   dim: '600 × 800 px',
   ratio: '3:4 عمودية (طولية)',
   note: 'كارت رأسي للأقسام — النسبة الطولية 3:4 تبرز تصميم وتفاصيل الدواليب والمطابخ'
  };
 }
 if (key.startsWith('projects.')) {
  return {
   dim: '800 × 500 px',
   ratio: '16:10 سينمائية',
   note: 'كروت معرض الأعمال — النسبة السينمائية 16:10 تعطي عمقاً وتوازناً للعمل'
  };
 }
 return {
  dim: '800 × 600 px',
  ratio: '4:3',
  note: 'المقاس الموصى به ليتناسب مع أبعاد الحاوية'
 };
}

function getImageFitConfig(key) {
 if (!key) return {};
 if (key === 'story.img') return C.story || {};
 if (key === 'banner.img') return C.banner || {};
 if (key.startsWith('cats.')) {
  const i = parseInt(key.split('.')[1]);
  return C.cats?.[i] || {};
 }
 if (key.startsWith('projects.')) {
  const i = parseInt(key.split('.')[1]);
  return C.projects?.[i] || {};
 }
 return {};
}

function setImageFitConfig(key, fit, pos, bgColor) {
 if (!key) return;
 if (key === 'story.img') {
  C.story = C.story || {};
  C.story.fit = fit; C.story.position = pos; C.story.bgColor = bgColor;
 } else if (key === 'banner.img') {
  C.banner = C.banner || {};
  C.banner.fit = fit; C.banner.position = pos; C.banner.bgColor = bgColor;
 } else if (key.startsWith('cats.')) {
  const i = parseInt(key.split('.')[1]);
  if (C.cats?.[i]) {
   C.cats[i].fit = fit; C.cats[i].position = pos; C.cats[i].bgColor = bgColor;
  }
 } else if (key.startsWith('projects.')) {
  const i = parseInt(key.split('.')[1]);
  if (C.projects?.[i]) {
   C.projects[i].fit = fit; C.projects[i].position = pos; C.projects[i].bgColor = bgColor;
  }
 }
 markDirty();
}

function updateImgPreview() {
 const preview = $('modalImgPreviewBox');
 if (!preview || !currentEditingImgKey) return;
 const currentUrl = getVal(currentEditingImgKey) || $('modalCustomUrl').value || 'images/banner-main.jpg';
 const fit = $('fitContain').checked ? 'contain' : 'cover';
 const pos = $('imgPosSelect').value;
 const bg = $('imgBgColorSelect').value;
 preview.style.backgroundImage = "url('" + currentUrl + "')";
 preview.style.backgroundSize = fit;
 preview.style.backgroundPosition = pos;
 preview.style.backgroundColor = bg;
 preview.style.backgroundRepeat = 'no-repeat';
}

function updateFitCardsUI(isContain) {
 const cCard = $('lblFitCover');
 const tCard = $('lblFitContain');
 if (cCard && tCard) {
  if (isContain) {
   tCard.style.borderColor = 'var(--gold)';
   tCard.style.background = 'rgba(245,184,0,0.12)';
   tCard.style.boxShadow = '0 0 16px rgba(245,184,0,0.2)';
   cCard.style.borderColor = 'rgba(255,255,255,0.12)';
   cCard.style.background = 'rgba(255,255,255,0.04)';
   cCard.style.boxShadow = 'none';
  } else {
   cCard.style.borderColor = 'var(--gold)';
   cCard.style.background = 'rgba(245,184,0,0.12)';
   cCard.style.boxShadow = '0 0 16px rgba(245,184,0,0.2)';
   tCard.style.borderColor = 'rgba(255,255,255,0.12)';
   tCard.style.background = 'rgba(255,255,255,0.04)';
   tCard.style.boxShadow = 'none';
  }
 }
}

function updateImgFitSettings() {
 if (!currentEditingImgKey) return;
 const isContain = $('fitContain').checked;
 const fit = isContain ? 'contain' : 'cover';
 const pos = $('imgPosSelect').value;
 const bg = $('imgBgColorSelect').value;
 updateFitCardsUI(isContain);
 setImageFitConfig(currentEditingImgKey, fit, pos, bg);
 updateImgPreview();
 renderImages();
}

/* ===== نافذة اختيار وتغيير الصور ===== */
function openImagePicker(key) {
 currentEditingImgKey = key;
 const specs = getImageSpecs(key);
 const dimEl = $('modalImgSpecDim');
 const ratioEl = $('modalImgSpecRatio');
 const noteEl = $('modalImgSpecNote');
 if (dimEl) dimEl.textContent = specs.dim;
 if (ratioEl) ratioEl.textContent = specs.ratio;
 if (noteEl) noteEl.textContent = specs.note;

 const cfg = getImageFitConfig(key);
 const isContain = (cfg.fit === 'contain');
 if (isContain) {
  $('fitContain').checked = true;
 } else {
  $('fitCover').checked = true;
 }
 updateFitCardsUI(isContain);
 $('imgPosSelect').value = cfg.position || 'center';
 $('imgBgColorSelect').value = cfg.bgColor || (cfg.fit === 'contain' ? '#0A1E36' : '#0A1E36');

 $('modalCustomUrl').value = getVal(key) || '';
 $('uploadStatus').textContent = '';
 $('modalFileInput').value = '';

 $('modalGalleryGrid').innerHTML = IMGS.map(n => {
  const url = 'images/' + n + '.jpg';
  const isSel = (getVal(key) === url);
  return `<div class="kyn-gallery-thumb ${isSel?'selected':''}" style="background-image:url('${url}')" onclick="selectGalleryImg('${url}')"><span>${n}</span></div>`;
 }).join('');

 updateImgPreview();
 openModal('imageModal');
}

function selectGalleryImg(url) {
 if (!currentEditingImgKey) return;
 applyNewImage(currentEditingImgKey, url);
 closeModal('imageModal');
}

function applyCustomImageUrl() {
 const url = $('modalCustomUrl').value.trim();
 if (url && currentEditingImgKey) {
  applyNewImage(currentEditingImgKey, url);
  closeModal('imageModal');
 }
}

function applyNewImage(key, url) {
 setVal(key, url);
 const fit = $('fitContain').checked ? 'contain' : 'cover';
 const pos = $('imgPosSelect').value;
 const bg = $('imgBgColorSelect').value;
 setImageFitConfig(key, fit, pos, bg);
 renderImages();
 updateImgPreview();
 toast('تم تحديث الصورة وضبط الحجم بنجاح ✓');
}

function handleModalUpload(file) {
 if (!file) return;
 $('uploadStatus').textContent = 'جاري رفع الصورة إلى السيرفر…';
 const rd = new FileReader();
 rd.onload = () => {
  const bytes = new Uint8Array(rd.result);
  const cleanName = currentEditingImgKey.replace(/[.]/g, '_') + '_' + Date.now() + '.jpg';

  fetch('upload.php', {
   method: 'POST',
   headers: { 'X-Img-Name': cleanName },
   body: bytes
  })
  .then(r => r.json())
  .then(data => {
   if (data.url) {
    $('uploadStatus').textContent = 'تم الرفع بنجاح ✓';
    applyNewImage(currentEditingImgKey, data.url);
    setTimeout(() => closeModal('imageModal'), 600);
   } else {
    fallbackLocalImage(rd.result);
   }
  })
  .catch(() => {
   fallbackLocalImage(rd.result);
  });
 };
 rd.readAsArrayBuffer(file);
}

function fallbackLocalImage(arrayBuffer) {
 const blob = new Blob([arrayBuffer]);
 const localUrl = URL.createObjectURL(blob);
 $('uploadStatus').textContent = 'تم تطبيق الصورة للمعاينة الحالية';
 applyNewImage(currentEditingImgKey, localUrl);
 setTimeout(() => closeModal('imageModal'), 1000);
}

function renderImages() {
 const sFit = C.story?.fit || 'cover';
 const sPos = C.story?.position || 'center';
 const sBg = C.story?.bgColor || (sFit === 'contain' ? '#0A1E36' : '');
 $('storyImg').style.backgroundImage = "url('" + (C.story?.img || 'images/banner-2.jpg') + "')";
 $('storyImg').style.backgroundSize = sFit;
 $('storyImg').style.backgroundPosition = sPos;
 $('storyImg').style.backgroundColor = sBg;
 $('storyImg').style.backgroundRepeat = 'no-repeat';

 const bFit = C.banner?.fit || 'cover';
 const bPos = C.banner?.position || 'center';
 const bBg = C.banner?.bgColor || (bFit === 'contain' ? '#081628' : '');
 $('banner').style.backgroundImage = "url('" + (C.banner?.img || 'images/banner-main.jpg') + "')";
 $('banner').style.backgroundSize = bFit;
 $('banner').style.backgroundPosition = bPos;
 $('banner').style.backgroundColor = bBg;
 $('banner').style.backgroundRepeat = 'no-repeat';

 renderCats();
 renderProjects();
}

/* ===== الأقسام ===== */
function renderCats() {
 const cats = C.cats || [];
 const html = cats.map((c, i) => {
  const fit = c.fit || 'cover';
  const pos = c.position || 'center';
  const bg = c.bgColor || (fit === 'contain' ? '#0A1E36' : 'transparent');
  return `
  <div class="cat-item has-img-edit" id="cat_item_${i}">
   <div class="kyn-item-ctrls">
    <button class="kyn-ctrl-btn kyn-ctrl-del" title="حذف القسم" onclick="deleteCat(${i})">&times;</button>
    <button class="kyn-ctrl-btn kyn-ctrl-mv" title="نقل لليمين" onclick="moveCat(${i}, -1)">→</button>
    <button class="kyn-ctrl-btn kyn-ctrl-mv" title="نقل لليسار" onclick="moveCat(${i}, 1)">←</button>
   </div>
   <i style="background-image:url('${c.img}');background-size:${fit};background-position:${pos};background-color:${bg};background-repeat:no-repeat">
    <button type="button" class="kyn-img-overlay-btn" onclick="openImagePicker('cats.${i}.img')">
     <span>📷 تغيير</span>
     <span class="kyn-size-tag">600×800 px</span>
    </button>
   </i>
   <span data-k="cats.${i}.label" contenteditable="true">${esc(c.label)}</span>
  </div>
 `;
 }).join('') + `
  <div class="kyn-add-card" onclick="addNewCat()">
   <span class="plus">+</span>
   <span>إضافة قسم جديد</span>
  </div>
 `;
 $('catGrid').innerHTML = html;
 bindInlineTextEditing();
}

function deleteCat(i) {
 if (confirm('هل أنت متأكد من حذف هذا القسم؟')) {
  C.cats.splice(i, 1);
  markDirty();
  renderCats();
 }
}

function moveCat(i, dir) {
 const target = i + dir;
 if (target >= 0 && target < C.cats.length) {
  const tmp = C.cats[i];
  C.cats[i] = C.cats[target];
  C.cats[target] = tmp;
  markDirty();
  renderCats();
 }
}

function addNewCat() {
 (C.cats = C.cats || []).push({
  id: 'cat-' + Date.now(),
  label: 'قسم جديد',
  href: '#contact',
  img: 'images/cat-kitchen.jpg'
 });
 markDirty();
 renderCats();
 toast('تمت إضافة قسم جديد');
}

/* ===== المميزات ===== */
function renderFeatures() {
 const feats = C.features || [];
 const ico = {
  shield: 'M24 4l16 6v12c0 11-7 18-16 22C15 40 8 33 8 22V10z M17 24l5 5 9-10',
  truck: 'M4 14h26v18H4z M30 20h8l6 6v6H30 M14 36a4 4 0 100-8 4 4 0 000 8z M36 36a4 4 0 100-8 4 4 0 000 8z',
  pen: 'M6 40l4-2 22-22-4-4L6 34z M28 10l6 6'
 };

 const html = feats.map((f, i) => `
  <div class="strip-item" style="position:relative">
   <div class="kyn-item-ctrls">
    <button class="kyn-ctrl-btn kyn-ctrl-del" title="حذف" onclick="deleteFeat(${i})">&times;</button>
    <button class="kyn-ctrl-btn kyn-ctrl-mv" title="تبديل الأيقونة" onclick="toggleFeatIcon(${i})">🛡️</button>
   </div>
   <svg viewBox="0 0 48 48"><path d="${ico[f.icon] || ico.shield}"/></svg>
   <span>
    <h3 data-k="features.${i}.title" contenteditable="true">${esc(f.title)}</h3>
    <p data-k="features.${i}.text" contenteditable="true">${esc(f.text)}</p>
   </span>
  </div>
 `).join('') + `
  <div class="kyn-add-card" style="min-height:90px" onclick="addNewFeat()">
   <span class="plus" style="font-size:20px">+</span>
   <span>إضافة ميزة</span>
  </div>
 `;
 $('featGrid').innerHTML = html;
 bindInlineTextEditing();
}

function deleteFeat(i) {
 if (confirm('هل تريد حذف هذه الميزة؟')) {
  C.features.splice(i, 1);
  markDirty();
  renderFeatures();
 }
}

function toggleFeatIcon(i) {
 const icons = ['shield', 'truck', 'pen'];
 const curr = C.features[i].icon || 'shield';
 const next = icons[(icons.indexOf(curr) + 1) % icons.length];
 C.features[i].icon = next;
 markDirty();
 renderFeatures();
 toast('تم تغيير الأيقونة إلى ' + next);
}

function addNewFeat() {
 (C.features = C.features || []).push({
  icon: 'shield',
  title: 'ميزة جديدة',
  text: 'اكتب تفاصيل الميزة هنا'
 });
 markDirty();
 renderFeatures();
}

/* ===== المشاريع ===== */
function renderProjects() {
 const projects = C.projects || [];
 const html = projects.map((p, i) => {
  const fit = p.fit || 'cover';
  const pos = p.position || 'center';
  const bg = p.bgColor || (fit === 'contain' ? '#0A1E36' : 'transparent');
  return `
  <div class="card has-img-edit">
   <div class="kyn-item-ctrls">
    <button class="kyn-ctrl-btn kyn-ctrl-del" title="حذف المشروع" onclick="deleteProject(${i})">&times;</button>
    <button class="kyn-ctrl-btn kyn-ctrl-mv" title="نقل لأعلى" onclick="moveProject(${i}, -1)">↑</button>
    <button class="kyn-ctrl-btn kyn-ctrl-mv" title="نقل لأسفل" onclick="moveProject(${i}, 1)">↓</button>
   </div>
   <div class="ph" style="background-image:url('${p.img}');background-size:${fit};background-position:${pos};background-color:${bg};background-repeat:no-repeat" role="img" aria-label="${esc(p.alt)}">
    <button type="button" class="kyn-img-overlay-btn" onclick="openImagePicker('projects.${i}.img')">
     <span>📷 تغيير</span>
     <span class="kyn-size-tag">800×500 px</span>
    </button>
   </div>
   <div class="tx">
    <h3 data-k="projects.${i}.title" contenteditable="true">${esc(p.title)}</h3>
    <p data-k="projects.${i}.caption" contenteditable="true">${esc(p.caption)}</p>
   </div>
  </div>
 `;
 }).join('') + `
  <div class="kyn-add-card" onclick="addNewProject()">
   <span class="plus">+</span>
   <span>إضافة مشروع جديد للمعرض</span>
  </div>
 `;
 $('projGrid').innerHTML = html;
 bindInlineTextEditing();
}

function deleteProject(i) {
 if (confirm('هل أنت متأكد من حذف هذا المشروع من المعرض؟')) {
  C.projects.splice(i, 1);
  markDirty();
  renderProjects();
 }
}

function moveProject(i, dir) {
 const target = i + dir;
 if (target >= 0 && target < C.projects.length) {
  const tmp = C.projects[i];
  C.projects[i] = C.projects[target];
  C.projects[target] = tmp;
  markDirty();
  renderProjects();
 }
}

function addNewProject() {
 (C.projects = C.projects || []).push({
  img: 'images/proj-shorouk.jpg',
  alt: 'مشروع جديد',
  title: 'مشروع جديد',
  caption: 'تفاصيل وخامات المشروع الجديد'
 });
 markDirty();
 renderProjects();
 toast('تمت إضافة مشروع جديد');
}

/* ===== الفوتر ===== */
